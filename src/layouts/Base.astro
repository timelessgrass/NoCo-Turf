---
/**
 * The one layout. Every page gets ONE JSON-LD @graph: WebSite, the single #business node (only when its
 * facts are renderable — src/data/brief.ts), WebPage (about → #business), BreadcrumbList when the page
 * passes crumbs, plus whatever page nodes it adds (Service, Article, Dataset, FAQPage mirroring the printed
 * FAQ). Never aggregateRating, ratingValue, reviewCount or Review — check-dist.mjs fails the build on any.
 */
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ActionBar from '../components/ActionBar.astro';
import { SITE, PRELAUNCH } from '../data/site';
import brief, { fact, businessName, legalName, phone, email, socialProfiles, location } from '../data/brief';

interface Props {
  title: string;
  description: string;
  /** Pages that must never be indexed (/thanks/, /review/, 404). */
  noindex?: boolean;
  crumbs?: { name: string; path: string }[];
  /** Extra JSON-LD nodes; they may reference `${SITE}/#business` by @id. */
  graph?: Record<string, unknown>[];
  /** 'photo' when the page opens on a full-bleed dark photograph (clear header until scroll). */
  tone?: 'photo' | 'ground';
  /** PREVIEW: this page's record is a draft / unconfirmed — show the ribbon. */
  draft?: boolean;
  ogImage?: string;
  /** What the WebPage node is about, when it is not the business: a community page is about a Place
   *  ({ '@id': …#place }, the Place node itself in `graph`). Default: the #business node. */
  about?: Record<string, unknown>;
  /** Extra stylesheet URLs this page alone links, in <head> (a `?url` import, so Vite still hashes and minifies
   *  it). For a page whose route is shared with pages that must not load its CSS — see
   *  src/pages/areas/[slug]/[service].astro. */
  styles?: string[];
}

const { title, description, noindex = false, crumbs = [], graph = [], tone = 'ground', draft = false, ogImage, about, styles = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE).href;
const robots = PRELAUNCH || noindex ? 'noindex, nofollow' : 'index, follow';

const BUSINESS_ID = `${SITE}/#business`;
const address = fact<Record<string, string>>(location.address);
const hours = fact<unknown[]>(location.hours);
const areas = (brief.service_areas ?? []).map((n: any) => fact<string>(n?.name ?? n)).filter(Boolean);

/* The #business node exists only when name AND phone are renderable facts — a half-entity with a guessed
   field is worse than none (check-entity.py compares every field to the brief). */
const business = businessName && phone ? {
  '@type': 'HomeAndConstructionBusiness',
  '@id': BUSINESS_ID,
  name: businessName,
  ...(legalName ? { legalName } : {}),
  url: `${SITE}/`,
  telephone: phone,
  ...(email ? { email } : {}),
  ...(address ? { address: { '@type': 'PostalAddress', ...address } } : {}),
  ...(areas.length ? { areaServed: areas.map((name: string) => ({ '@type': 'City', name })) } : {}),
  ...(hours ? { openingHoursSpecification: hours } : {}),
  ...(socialProfiles.length ? { sameAs: socialProfiles.map((p) => p.url) } : {}),
} : null;

const nodes: Record<string, unknown>[] = [
  { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: businessName ?? 'NoCo Turf Co.' },
  ...(business ? [business] : []),
  {
    '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: title, description,
    isPartOf: { '@id': `${SITE}/#website` },
    ...(about ? { about } : business ? { about: { '@id': BUSINESS_ID } } : {}),
  },
  ...(crumbs.length ? [{
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', path: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, SITE).href,
    })),
  }] : []),
  ...graph,
];
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': nodes });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#13120f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={businessName ?? 'NoCo Turf Co.'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, SITE).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {styles.map((href) => <link rel="stylesheet" href={href} />)}
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader tone={tone} />
    {draft && <p class="draft-ribbon" role="note">Draft preview — not published. Facts pending Brian's confirmation.</p>}
    <main id="main" class:list={{ 'main--under': tone !== 'photo' }}>
      <slot />
    </main>
    <SiteFooter />
    <ActionBar />
  </body>
</html>

<style is:global>
  .main--under { padding-top: var(--header-h); }
  .draft-ribbon { position: fixed; z-index: 60; left: 50%; bottom: calc(var(--bar-h) + 12px); translate: -50% 0; margin: 0;
    padding: 8px 14px; border-radius: var(--r-chip); background: var(--ink); color: var(--bone); font-size: 0.8rem; font-weight: 600;
    box-shadow: 0 0 0 2px var(--paint); white-space: nowrap; pointer-events: none; }
  @media (max-width: 599px) {
    .draft-ribbon { white-space: normal; width: max-content; max-width: calc(100% - 24px); text-align: center; font-size: 0.74rem; line-height: 1.3; border-radius: 12px; }
  }
</style>
