---
/**
 * The proof beat as a contact sheet: numbered frames, each with its record line (what · where · when).
 * Desktop: an editorial grid where frame size tracks the photo, not a uniform card grid. Mobile: a
 * snap-scrolling strip with a frame counter. The Open (M6): a tap opens the frame full-screen, morphing out
 * of the thumbnail with a same-document View Transition; without JS every frame links to its full-size file.
 */
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import { monthLabel, type Photo as P } from '../data/photos';

interface Props { photos: P[]; layout?: 'sheet' | 'strip'; }
const { photos, layout = 'sheet' } = Astro.props;
const full = await Promise.all(photos.map((p) => getImage({ src: p.src, width: Math.min(2000, p.src.width), format: 'webp', quality: 78 })));
const spans = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i'];
---
<div class:list={['reel', `reel--${layout}`]} data-reel>
  <ol class="reel__grid" role="list">
    {photos.map((p, i) => (
      <li class:list={['reel__item', `reel__item--${spans[i % spans.length]}`]}>
        <figure>
          <a class="reel__frame develop" href={full[i].src} data-full={full[i].src} data-index={i} aria-label={`Open photo ${i + 1}: ${p.caption}`}>
            <Photo photo={p} sizes="(max-width: 899px) 86vw, 50vw" widths={[480, 800, 1200]} />
          </a>
          <figcaption>
            <span class="reel__no num">{String(i + 1).padStart(2, '0')}</span>
            <span class="reel__cap">{p.caption}</span>
            <span class="reel__rec">{p.place}{p.month && <> · {monthLabel(p.month)}</>}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ol>
  <p class="reel__count label" aria-hidden="true"><span data-reel-now>01</span> / {String(photos.length).padStart(2, '0')}</p>

  <dialog class="lb" data-lb aria-label="Photo viewer">
    <figure class="lb__fig">
      <img data-lb-img alt="" src={full[0].src} width={full[0].attributes.width} height={full[0].attributes.height} loading="lazy" decoding="async" />
      <figcaption data-lb-cap></figcaption>
    </figure>
    <div class="lb__ctl">
      <button type="button" class="lb__btn" data-lb-prev aria-label="Previous photo">←</button>
      <button type="button" class="lb__btn" data-lb-next aria-label="Next photo">→</button>
      <button type="button" class="lb__btn lb__btn--close" data-lb-close aria-label="Close">✕</button>
    </div>
  </dialog>
  <script type="application/json" data-lb-data set:html={JSON.stringify(photos.map((p, i) => ({ src: full[i].src, w: full[i].attributes.width, h: full[i].attributes.height, alt: p.alt, cap: `${String(i + 1).padStart(2, '0')} · ${p.caption} — ${p.place}${p.month ? `, ${monthLabel(p.month)}` : ''}` })))} />
</div>

<style>
  .reel__grid { list-style: none; display: grid; gap: clamp(14px, 1.6vw, 24px); }
  .reel figure { margin: 0; }
  .reel__frame { display: block; overflow: hidden; border-radius: var(--r-photo); background: var(--ground-2); cursor: zoom-in; }
  .reel__frame :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale var(--t4) var(--ease); }
  .reel__frame:hover :global(img) { scale: 1.03; }
  figcaption { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; padding-top: 10px; font-size: var(--fs-small); }
  .reel__no { grid-row: span 2; font-family: var(--font-display); font-weight: 800; font-stretch: 110%; color: var(--paint); font-size: 0.95rem; padding-top: 1px; }
  .reel__cap { font-weight: 600; }
  .reel__rec { color: var(--ink-3); font-size: 0.85rem; }
  .on-slab .reel__rec { color: var(--bone-3); }
  .reel__count { display: none; }

  @media (min-width: 900px) {
    .reel--sheet .reel__grid { grid-template-columns: repeat(12, 1fr); grid-auto-flow: dense; }
    .reel__item--a { grid-column: span 7; grid-row: span 2; }
    .reel__item--b, .reel__item--c { grid-column: span 5; }
    .reel__item--d, .reel__item--e, .reel__item--f { grid-column: span 4; }
    .reel__item--g { grid-column: span 8; }
    .reel__item--h { grid-column: span 4; }
    .reel__item--i { grid-column: span 12; }
    .reel__item--a .reel__frame { aspect-ratio: 4 / 3.72; }
    .reel__item--b .reel__frame, .reel__item--c .reel__frame { aspect-ratio: 16 / 10; }
    .reel__item--d .reel__frame, .reel__item--f .reel__frame { aspect-ratio: 4 / 5; }
    .reel__item--e .reel__frame { aspect-ratio: 4 / 5; }
    .reel__item--g .reel__frame { aspect-ratio: 16 / 8.2; }
    .reel__item--h .reel__frame { aspect-ratio: 4 / 4.7; }
  }
  @media (max-width: 899px) {
    .reel__grid { grid-auto-flow: column; grid-auto-columns: 84%; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
      padding-inline: var(--gutter); margin-inline: calc(-1 * var(--gutter)); scroll-padding-inline: var(--gutter); scrollbar-width: none; }
    .reel__grid::-webkit-scrollbar { display: none; }
    .reel__item { scroll-snap-align: start; }
    .reel__frame { aspect-ratio: 4 / 4.6; }
    .reel__count { display: block; margin-top: 14px; text-align: right; }
  }

  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgb(12 11 9 / 0.97); color: var(--bone); }
  .lb::backdrop { background: transparent; }
  .lb__fig { height: 100%; margin: 0; display: grid; grid-template-rows: 1fr auto; place-items: center; padding: 56px 16px 20px; gap: 14px; }
  .lb__fig img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--r-photo); view-transition-name: lb-photo; }
  .lb__fig figcaption { font-size: var(--fs-small); color: var(--bone-2); text-align: center; max-width: 60ch; padding-bottom: env(safe-area-inset-bottom); }
  .lb__ctl { position: absolute; top: 10px; right: 10px; display: flex; gap: 6px; }
  .lb__btn { width: 48px; height: 48px; border-radius: var(--r-chip); border: 0; background: rgb(var(--bone-rgb) / 0.1); color: var(--bone); font-size: 1.15rem; cursor: pointer; transition: background var(--t2) var(--ease), transform var(--t1) var(--ease); }
  .lb__btn:hover { background: rgb(var(--bone-rgb) / 0.2); }
  .lb__btn:active { transform: scale(0.95); }
  .lb__btn--close { background: var(--paint); color: var(--ink); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
    const data = JSON.parse(reel.querySelector('[data-lb-data]')!.textContent || '[]') as { src: string; w: number; h: number; alt: string; cap: string }[];
    const lb = reel.querySelector<HTMLDialogElement>('[data-lb]')!;
    const img = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
    const frames = [...reel.querySelectorAll<HTMLAnchorElement>('.reel__frame')];
    let at = 0;
    const vt = (fn: () => void) => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const d = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (!reduce && d.startViewTransition) d.startViewTransition(fn); else fn();
    };
    const show = (i: number) => {
      at = (i + data.length) % data.length;
      const d = data[at];
      img.src = d.src; img.width = d.w; img.height = d.h; img.alt = d.alt; cap.textContent = d.cap;
    };
    frames.forEach((a, i) => {
      a.addEventListener('pointerdown', () => { const pre = new Image(); pre.src = data[i].src; }, { once: true });
      a.addEventListener('click', (e) => {
        if (!lb.showModal) return;
        e.preventDefault();
        const thumb = a.querySelector('img');
        if (thumb) thumb.style.viewTransitionName = 'lb-photo';
        img.style.viewTransitionName = '';
        vt(() => { if (thumb) thumb.style.viewTransitionName = ''; img.style.viewTransitionName = 'lb-photo'; show(i); lb.showModal(); });
      });
    });
    const close = () => {
      const thumb = frames[at]?.querySelector('img');
      vt(() => { img.style.viewTransitionName = ''; if (thumb) thumb.style.viewTransitionName = 'lb-photo'; lb.close(); });
      setTimeout(() => { if (thumb) thumb.style.viewTransitionName = ''; }, 600);
    };
    lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(at - 1));
    lb.querySelector('[data-lb-next]')!.addEventListener('click', () => show(at + 1));
    lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
    lb.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(at - 1); if (e.key === 'ArrowRight') show(at + 1); });
    let x0 = 0;
    lb.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    lb.addEventListener('pointerup', (e) => { const dx = e.clientX - x0; if (Math.abs(dx) > 50) show(at + (dx < 0 ? 1 : -1)); });

    /* mobile frame counter */
    const now = reel.querySelector('[data-reel-now]');
    const grid = reel.querySelector<HTMLElement>('.reel__grid')!;
    if (now && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((en) => {
        if (en.isIntersecting) now.textContent = String(frames.indexOf(en.target.querySelector('.reel__frame') as HTMLAnchorElement) + 1).padStart(2, '0');
      }), { root: grid, threshold: 0.6 });
      reel.querySelectorAll('.reel__item').forEach((li) => io.observe(li));
    }
  });
</script>
