---
/**
 * A guide's Markdown body, re-set as a reference document. The Markdown stays the single source of the
 * words; this component only changes how they are set, at build time, so every reader (and every
 * crawler, and the no-JS visitor) gets the same finished HTML:
 *   - each H2 opens a numbered <section> (01, 02 …) that the table of contents and scroll-spy follow;
 *   - tables become scannable at 390px: stacked records under 720px (every cell carries its column
 *     name), a sideways-scrolling sheet with a pinned first column from 720px, a plain table with a
 *     sticky header from 1200px — with real row headers and explicit ARIA roles, because a table
 *     re-displayed as blocks loses its semantics in some browsers;
 *   - blockquotes (the letter templates) become documents you could print, with the [brackets]
 *     marked as the fields to fill;
 *   - a paragraph that opens with a bold "It depends …" becomes an uncertainty note — drawn dashed,
 *     like a proposed line on a site plan, because the rule behind it is not settled;
 *   - the opening "Checked …" paragraph is set as the intro.
 * An optional `island` slot (a tool) is placed in the section named by `islandIn`, just before that
 * section's first template, which the tool may then stand in for (data-gdoc-replace) — or, with
 * islandIn=":lead", right after the opening paragraph.
 */
interface Props { islandIn?: string; }
const { islandIn } = Astro.props;

const raw = await Astro.slots.render('default');
const island = Astro.slots.has('island') ? await Astro.slots.render('island') : '';

const strip = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const attr = (s: string) => s.replace(/"/g, '&quot;').replace(/</g, '&lt;');
const pad = (n: number) => String(n).padStart(2, '0');
let tables = 0;
let docs = 0;

function table(src: string, caption: string) {
  tables++;
  const head = (src.match(/<thead>([\s\S]*?)<\/thead>/) ?? [])[1] ?? '';
  const labels = [...head.matchAll(/<th(?:\s[^>]*)?>([\s\S]*?)<\/th>/g)].map((m) => strip(m[1]));
  const cols = labels.length;
  let t = src
    .replace('<table>', `<table class="gtable__t" role="table">${caption ? `<caption class="sr">${caption}</caption>` : ''}`)
    .replace('<thead>', '<thead role="rowgroup">')
    .replace(/<th(\s[^>]*)?>/g, (_, a?: string) => `<th${a ?? ''} scope="col" role="columnheader">`);
  t = t.replace(/<tbody>([\s\S]*?)<\/tbody>/, (_, body: string) => `<tbody role="rowgroup">${body.replace(/<tr>([\s\S]*?)<\/tr>/g, (_r, row: string) => {
    let i = 0;
    const cells = row.replace(/<td([^>]*)>([\s\S]*?)<\/td>/g, (_c, a: string, inner: string) => {
      const k = i++;
      if (k === 0) return `<th${a} scope="row" role="rowheader">${inner}</th>`;
      const empty = /^[\s—–-]*$/.test(strip(inner));
      return `<td${a} role="cell" data-label="${attr(labels[k] ?? '')}"${empty ? ' class="is-empty"' : ''}>${inner}</td>`;
    });
    return `<tr role="row">${cells}</tr>`;
  })}</tbody>`);
  t = t.replace(/<tr>/g, '<tr role="row">');
  const emph = /dollars/i.test(labels[cols - 1] ?? '');
  return `<div class="gtable gtable--c${cols}${emph ? ' gtable--emph' : ''}" data-gtable><div class="gtable__scroll" role="region" tabindex="0" aria-label="${attr(`Table: ${caption || 'details'}`)}">${t}</div><p class="gtable__hint" aria-hidden="true">Scroll sideways for every column</p></div>`;
}

function doc(inner: string) {
  docs++;
  const fields = inner.replace(/\[([^\]<>]{1,90})\]/g, '<span class="gfill">[$1]</span>');
  return `<div class="gdoc" data-gdoc><p class="gdoc__tab" data-md="skip"><span class="label">Template ${pad(docs)}</span><span class="gdoc__hint">Fill in the <span class="gfill">[brackets]</span></span></p><blockquote class="gdoc__sheet">${fields}</blockquote><div class="gdoc__acts" data-gdoc-acts hidden><button type="button" class="btn btn--line gdoc__copy" data-gdoc-copy>Copy this template</button><span class="gdoc__status" role="status" aria-live="polite" data-gdoc-status></span></div></div>`;
}

const NOTE = `<p class="gnote__k" data-md="skip"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10" class="gnote__ring" /><path d="M9.3 9.4a2.8 2.8 0 1 1 3.9 2.6c-.8.4-1.2 1-1.2 1.8v.6M12 17.4v.2" /></svg><span class="label">Check before you plan</span></p>`;

function blocks(seg: string, caption: string) {
  return seg
    .replace(/<table>[\s\S]*?<\/table>/g, (t) => table(t, caption))
    .replace(/<blockquote>([\s\S]*?)<\/blockquote>/g, (_, inner: string) => doc(inner))
    .replace(/<p><strong>(It depends[\s\S]*?)<\/strong>([\s\S]*?)<\/p>/g, (_, lead: string, rest: string) =>
      `<div class="gnote" role="note">${NOTE}<p><strong>${lead}</strong>${rest}</p></div>`);
}

const H2 = /<h2 id="([^"]+)">([\s\S]*?)<\/h2>/g;
const marks = [...raw.matchAll(H2)];
let lead = raw.slice(0, marks[0]?.index ?? raw.length);
lead = lead.replace(/^\s*<p><strong>(Checked[^<]*)<\/strong>/, '<p class="gintro"><strong>$1</strong>');
let html = `<div class="gprose__lead">${blocks(lead, '')}</div>${island && islandIn === ':lead' ? island : ''}`;
marks.forEach((m, i) => {
  const [whole, id, text] = m;
  const start = m.index! + whole.length;
  const end = marks[i + 1]?.index ?? raw.length;
  let body = blocks(raw.slice(start, end), strip(text));
  if (island && id === islandIn) {
    const at = body.indexOf('<div class="gdoc" data-gdoc>');
    body = at >= 0
      ? `${body.slice(0, at)}${island}<div class="gdoc" data-gdoc data-gdoc-replace>${body.slice(at + '<div class="gdoc" data-gdoc>'.length)}`
      : `${body}${island}`;
  }
  html += `<section class="gsec" aria-labelledby="${id}" data-gsec="${id}"><h2 id="${id}" class="gh2"><span class="gh2__no num" aria-hidden="true">${pad(i + 1)}</span><span class="gh2__t">${text}</span></h2>${body}</section>`;
});
---
<div class="prose gprose" set:html={html} />

<style>
  .gprose { max-width: none; }
  .gprose :global(:is(p, ul, ol)) { max-width: 68ch; }
  .gprose :global(.gprose__lead > p:first-child) { margin-top: 0; }
  .gprose :global(.gintro) { font-size: var(--fs-lede); line-height: 1.5; color: var(--ink-2); max-width: 54ch; margin-bottom: 0.2em; }
  .gprose :global(.gintro strong) { color: var(--ink); font-weight: 680; }

  /* ── Sections and numbered heads ── */
  .gprose :global(.gsec) { padding-top: clamp(48px, 5vw, 80px); }
  .gprose :global(.gh2) { margin: 0 0 0.55em; max-width: 24ch; scroll-margin-top: 24px; }
  .gprose :global(.gh2__no) { display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
    font-family: var(--font-display); font-size: var(--fs-label); font-weight: 700; font-stretch: 80%; letter-spacing: 0.17em; color: var(--ink-3); }
  .gprose :global(.gh2__no::after) { content: ''; width: 56px; height: 3px; border-radius: 2px;
    background: repeating-linear-gradient(90deg, var(--paint) 0 12px, transparent 12px 19px); transform-origin: left; }
  .gprose :global(.gh2__t) { display: block; }
  @media (max-width: 1199px) { .gprose :global(.gh2) { scroll-margin-top: 72px; } }

  /* Lists: a short layout mark instead of a bullet. */
  .gprose :global(:is(.gsec, .gprose__lead) > ul) { list-style: none; padding-left: 0; }
  .gprose :global(:is(.gsec, .gprose__lead) > ul > li) { position: relative; padding-left: 26px; margin: 0.55em 0; }
  .gprose :global(:is(.gsec, .gprose__lead) > ul > li::before) { content: ''; position: absolute; left: 2px; top: 0.78em; width: 12px; height: 2.5px; border-radius: 2px; background: var(--paint); }
  .gprose :global(:is(.gsec, .gprose__lead) > ol) { padding-left: 1.6em; }
  .gprose :global(:is(.gsec, .gprose__lead) > ol > li) { padding-left: 6px; margin: 0.55em 0; }
  .gprose :global(:is(.gsec, .gprose__lead) > ol > li::marker) { font-family: var(--font-display); font-weight: 780; font-stretch: 108%; color: var(--ink-3); }
  .gprose :global(a) { text-decoration-color: rgb(var(--ink-rgb) / 0.4); overflow-wrap: anywhere; }
  .gprose :global(a:hover) { text-decoration-color: var(--paint); }

  /* ── Tables ── */
  .gprose :global(.gtable) { margin: 1.6em 0 2em; position: relative; }
  .gprose :global(.gtable__t) { width: 100%; border-collapse: separate; border-spacing: 0; font-size: var(--fs-small); line-height: 1.5; margin: 0;
    font-variant-numeric: tabular-nums lining-nums; }
  .gprose :global(.gtable__t th), .gprose :global(.gtable__t td) { text-align: left; vertical-align: top; }
  .gprose :global(.gtable__hint) { display: none; }

  @media (max-width: 719px) {
    /* stacked records: one card per row, every value under its column name */
    .gprose :global(.gtable__t), .gprose :global(.gtable__t :is(tbody, tr, th, td)) { display: block; }
    .gprose :global(.gtable__t thead) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .gprose :global(.gtable__t tbody tr) { padding: 16px 0 14px; border-top: 1px dashed rgb(var(--ink-rgb) / 0.3); }
    .gprose :global(.gtable__t tbody tr:first-child) { border-top: 2px solid var(--ink); }
    .gprose :global(.gtable__t tbody tr:last-child) { border-bottom: 1px dashed rgb(var(--ink-rgb) / 0.3); }
    .gprose :global(.gtable__t :is(th, td)) { border: 0; }
    .gprose :global(.gtable__t tbody th) { padding: 0 0 8px; text-transform: none; font-family: var(--font-display); font-weight: 760; font-stretch: 106%; font-size: 1.14rem; letter-spacing: -0.015em; line-height: 1.2; }
    .gprose :global(.gtable__t td) { padding: 7px 0; color: var(--ink-2); }
    .gprose :global(.gtable__t td::before) { content: attr(data-label); content: attr(data-label) / ''; display: block; margin-bottom: 2px;
      font-family: var(--font-display); font-size: var(--fs-label); font-weight: 650; font-stretch: 78%; letter-spacing: 0.15em; text-transform: uppercase; line-height: 1.35; color: var(--ink-3); }
    .gprose :global(.gtable__t td.is-empty) { display: none; }
    .gprose :global(.gtable--emph td:last-child) { color: var(--ink); font-family: var(--font-display); font-weight: 760; font-stretch: 104%; font-size: 1.2rem; letter-spacing: -0.01em; }
    .gprose :global(.gtable--emph td:last-child::before) { font-size: var(--fs-label); letter-spacing: 0.15em; }
  }

  @media (min-width: 720px) {
    /* a sheet that scrolls sideways when it must: the first column stays pinned, and the far edge
       carries a shadow that only a scrolled-to-the-end table covers (background-attachment: local) */
    .gprose :global(.gtable__scroll) { overflow-x: auto; overscroll-behavior-x: contain; border-radius: 2px;
      background:
        linear-gradient(to left, var(--ground) 40%, rgb(239 235 226 / 0)) right / 56px 100% no-repeat local,
        radial-gradient(farthest-side at 100% 50%, rgb(var(--ink-rgb) / 0.2), rgb(var(--ink-rgb) / 0)) right / 16px 100% no-repeat scroll; }
    .gprose :global(.gtable--c6 .gtable__t) { min-width: 940px; }
    .gprose :global(.gtable--c5 .gtable__t) { min-width: 820px; }
    .gprose :global(.gtable--c4 .gtable__t) { min-width: 680px; }
    .gprose :global(.gtable__t thead th) { padding: 0 18px 12px 0; vertical-align: bottom; border-bottom: 2px solid var(--ink);
      font-family: var(--font-display); font-size: var(--fs-label); font-weight: 650; font-stretch: 78%; letter-spacing: 0.15em; text-transform: uppercase; line-height: 1.35; color: var(--ink-3); background: var(--ground); }
    .gprose :global(.gtable__t tbody :is(th, td)) { padding: 15px 18px 15px 0; border-bottom: 1px dashed rgb(var(--ink-rgb) / 0.28); }
    .gprose :global(.gtable__t td) { color: var(--ink-2); }
    .gprose :global(.gtable__t td.is-empty) { color: var(--ink-3); }
    .gprose :global(.gtable__t tbody th) { text-transform: none; font-family: var(--font-display); font-weight: 720; font-stretch: 104%; font-size: 1rem; letter-spacing: -0.01em; line-height: 1.3; color: var(--ink); min-width: 150px; }
    .gprose :global(.gtable__t :is(thead th, tbody th):first-child) { position: sticky; left: 0; z-index: 1; background: var(--ground); }
    .gprose :global(.gtable[data-overflow] .gtable__t :is(thead th, tbody th):first-child) { box-shadow: 1px 0 0 var(--line); padding-left: 0; }
    .gprose :global(.gtable[data-overflow] .gtable__hint) { display: flex; align-items: center; gap: 8px; margin: 10px 0 0; font-size: 0.82rem; color: var(--ink-3); }
    .gprose :global(.gtable[data-overflow] .gtable__hint::after) { content: ''; width: 36px; height: 2px; border-radius: 2px; background: var(--ink-3);
      mask: linear-gradient(90deg, transparent, #000); }
    .gprose :global(.gtable--emph .gtable__t td:last-child) { color: var(--ink); font-family: var(--font-display); font-weight: 740; font-stretch: 104%; font-size: 1rem; }
    .gprose :global(.gtable__t tbody tr) { transition: background-color var(--t2) var(--ease); }
    .gprose :global(.gtable__t tbody tr:hover :is(th, td)) { background-color: var(--ground-2); }
  }
  @media (min-width: 1200px) {
    /* the column is wide enough: no sideways scroll, and the header row follows you down a long table */
    .gprose :global(.gtable__scroll) { overflow: visible; background: none; }
    .gprose :global(.gtable .gtable__t) { min-width: 0; }
    .gprose :global(.gtable__t thead th) { position: sticky; top: var(--header-h); z-index: 2; padding-top: 14px; }
    .gprose :global(.gtable[data-overflow] .gtable__hint) { display: none; }
  }

  /* ── Templates, set as documents ── */
  .gprose :global(.gdoc) { margin: 1.8em 0 2.2em; max-width: 72ch; }
  .gprose :global(.gdoc[hidden]) { display: none; }
  .gprose :global(.gdoc__tab) { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 16px; margin: 0 0 12px; max-width: none; }
  .gprose :global(.gdoc__hint) { font-size: 0.85rem; color: var(--ink-3); }
  .gprose :global(.gdoc__sheet) { position: relative; margin: 0; padding: clamp(26px, 4.4vw, 56px) clamp(22px, 4.6vw, 60px); border-radius: var(--r-photo);
    background: var(--bone); box-shadow: 0 0 0 1px var(--line), var(--shadow-lift); font-size: 0.98rem; line-height: 1.62; color: var(--ink); }
  /* fold marks at a third and two thirds, as on letter paper */
  .gprose :global(.gdoc__sheet::before), .gprose :global(.gdoc__sheet::after) { content: ''; position: absolute; left: 0; width: 12px; height: 1.5px; background: rgb(var(--ink-rgb) / 0.3); }
  .gprose :global(.gdoc__sheet::before) { top: 33.3%; }
  .gprose :global(.gdoc__sheet::after) { top: 66.6%; }
  .gprose :global(.gdoc__sheet p) { white-space: pre-line; margin: 0 0 1em; max-width: 62ch; }
  .gprose :global(.gdoc__sheet p:last-child) { margin-bottom: 0; }
  .gprose :global(.gfill) { padding: 0 2px; border-radius: 2px; background: rgb(var(--paint-rgb) / 0.13); box-shadow: inset 0 -2px 0 rgb(var(--paint-rgb) / 0.75); -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .gprose :global(.gdoc__acts) { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 14px; }
  .gprose :global(.gdoc__acts[hidden]) { display: none; }
  .gprose :global(.gdoc__copy) { min-height: 46px; padding: 0 18px; font-size: 0.95rem; }
  .gprose :global(.gdoc__status) { font-size: var(--fs-small); color: var(--ink-2); }

  /* ── Uncertainty notes ── */
  .gprose :global(.gnote) { position: relative; max-width: 68ch; margin: 1.8em 0; padding: 18px 22px 20px; border-radius: var(--r-panel);
    border: 1.5px dashed rgb(var(--ink-rgb) / 0.34); background: rgb(var(--ink-rgb) / 0.025); }
  .gprose :global(.gnote__k) { display: flex; align-items: center; gap: 10px; margin: 0 0 8px; }
  .gprose :global(.gnote__k svg) { flex: none; fill: none; stroke-linecap: round; }
  .gprose :global(.gnote__k path) { stroke: var(--ink); stroke-width: 1.9; }
  .gprose :global(.gnote__ring) { stroke: var(--paint); stroke-width: 2.2; stroke-dasharray: 3.2 3.1; }
  .gprose :global(.gnote__k .label) { color: var(--ink-2); }
  .gprose :global(.gnote p:last-child) { margin: 0; }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      @keyframes gh2-mark { from { scale: 0 1; } to { scale: 1 1; } }
      .gprose :global(.gh2__no::after) { animation: gh2-mark linear both; animation-timeline: view(); animation-range: entry 40% cover 30%; }
    }
  }
</style>

<script>
  /* Tables: show the sideways hint (and keep the scroll area in the tab order) only when a table
     actually overflows. Templates: a Copy button, where the clipboard exists. */
  document.querySelectorAll<HTMLElement>('[data-gtable]').forEach((w) => {
    const s = w.querySelector<HTMLElement>('.gtable__scroll');
    if (!s) return;
    const set = () => {
      const over = s.scrollWidth > s.clientWidth + 2;
      w.toggleAttribute('data-overflow', over);
      if (over) s.setAttribute('tabindex', '0'); else s.removeAttribute('tabindex');
    };
    set();
    if ('ResizeObserver' in window) new ResizeObserver(set).observe(s);
  });
  document.querySelectorAll<HTMLElement>('[data-gdoc]').forEach((d) => {
    const acts = d.querySelector<HTMLElement>('[data-gdoc-acts]');
    const btn = d.querySelector<HTMLButtonElement>('[data-gdoc-copy]');
    const status = d.querySelector<HTMLElement>('[data-gdoc-status]');
    if (!acts || !btn || !status || !navigator.clipboard) return;
    acts.hidden = false;
    btn.addEventListener('click', async () => {
      const text = [...d.querySelectorAll('blockquote p')].map((p) => (p.textContent ?? '').trim()).join('\n\n');
      try { await navigator.clipboard.writeText(text); status.textContent = 'Copied. Paste it into an email or a document and fill in the brackets.'; }
      catch { status.textContent = 'Copying is blocked here. Select the text and copy it instead.'; }
    });
  });
</script>
