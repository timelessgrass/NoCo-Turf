---
/**
 * On-this-page contents for a guide, built from the Markdown H2s (numbered to match GuideProse) plus
 * any extra stops the page adds (a tool, the questions, the sources).
 *   desktop ≥1200px: a sticky column; a painted layout line runs down its rail as you read
 *                    (CSS scroll-driven, on the --gread view timeline the page declares).
 *   under 1200px:    a native <details> disclosure. It ships OPEN, so without JavaScript it is a plain
 *                    contents list; with JS an inline script closes it before first paint and it
 *                    becomes a sticky bar under the header that names the section you're in.
 * Scroll-spy marks the current entry with aria-current (a rAF-throttled scroll listener).
 */
import Icon from './Icon.astro';
import { phoneHref, phoneDisplay } from '../data/brief';

interface Item { id: string; text: string; no?: string }
interface Props { items: Item[]; checked: string; sources: number; }
const { items, checked, sources } = Astro.props;
---
<nav class="gtoc" aria-label="On this page" data-gtoc>
  <details class="gtoc__d" open data-gtoc-d>
    <summary class="gtoc__sum">
      <span class="label gtoc__sum-k">Contents</span>
      <span class="gtoc__now" data-gtoc-now>Jump to a section</span>
      <Icon name="chevron" size={18} class="gtoc__chev" />
      <span class="gtoc__bar" aria-hidden="true"></span>
    </summary>
    <div class="gtoc__panel">
      <p class="label gtoc__title">On this page</p>
      <ol class="gtoc__list" role="list">
        {items.map((it) => (
          <li>
            <a href={`#${it.id}`} data-gtoc-link={it.id} class:list={['gtoc__a', { 'gtoc__a--extra': !it.no }]}>
              <span class="gtoc__no num" aria-hidden="true">{it.no ?? '·'}</span><span class="gtoc__t">{it.text}</span>
            </a>
          </li>
        ))}
      </ol>
      <div class="gtoc__foot">
        <p class="gtoc__rec">Checked <time datetime={checked}>{checked}</time><br /><a href="#sources">{sources} sources, each dated</a></p>
        {phoneHref && <a class="gtoc__call" href={phoneHref} data-cta="toc-call" aria-label={`Ask about your yard: call ${phoneDisplay}`}><Icon name="phone" size={17} />Ask about your yard <span class="num">{phoneDisplay}</span></a>}
      </div>
    </div>
  </details>
</nav>
<script is:inline>
  (function () {
    var d = document.querySelector('[data-gtoc-d]');
    if (!d) return;
    d.closest('[data-gtoc]').setAttribute('data-js', '');
    if (window.matchMedia('(max-width: 1199px)').matches) d.open = false;
  })();
</script>

<style>
  .gtoc { position: relative; z-index: 20; }
  .gtoc__sum { list-style: none; cursor: pointer; }
  .gtoc__sum::-webkit-details-marker { display: none; }
  .gtoc__title { margin: 0 0 14px; }
  .gtoc__list { list-style: none; position: relative; display: grid; }
  .gtoc__a { display: grid; grid-template-columns: 26px 1fr; gap: 8px; align-items: baseline; padding: 8px 0 8px 14px; text-decoration: none;
    font-size: 0.9rem; line-height: 1.35; color: var(--ink-2); transition: color var(--t2) var(--ease); }
  .gtoc__a:hover { color: var(--ink); }
  .gtoc__a:hover .gtoc__t { text-decoration: underline; text-decoration-color: var(--paint); }
  .gtoc__no { font-family: var(--font-display); font-weight: 740; font-stretch: 100%; font-size: 0.78rem; color: var(--ink-3); }
  .gtoc__a[aria-current] { color: var(--ink); font-weight: 650; }
  .gtoc__a[aria-current] .gtoc__no { color: var(--ink); }
  .gtoc__a--extra { font-size: 0.86rem; }
  .gtoc__foot { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); display: grid; gap: 14px; }
  .gtoc__rec { margin: 0; font-size: 0.84rem; color: var(--ink-3); line-height: 1.5; }
  .gtoc__rec a { color: var(--ink-2); }
  .gtoc__call { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; justify-self: start; padding: 0 14px; border-radius: var(--r-chip);
    box-shadow: inset 0 0 0 1.5px currentColor; text-decoration: none; font-family: var(--font-display); font-weight: 680; font-size: 0.9rem; transition: box-shadow var(--t2) var(--ease); }
  .gtoc__call:hover { box-shadow: inset 0 0 0 1.5px var(--paint); }
  .gtoc__call .num { display: none; }
  .gtoc__bar { display: none; }

  /* ── Desktop: the rail ── */
  @media (min-width: 1200px) {
    .gtoc { position: sticky; top: calc(var(--header-h) + 32px); max-height: calc(100vh - var(--header-h) - 56px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
    .gtoc__sum { display: none; }
    .gtoc__list::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 2px;
      background: repeating-linear-gradient(180deg, rgb(var(--ink-rgb) / 0.22) 0 6px, transparent 6px 11px); }
    .gtoc__list::after { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 2px; border-radius: 2px; background: var(--paint); transform-origin: top; display: none; }
    .gtoc__a[aria-current]::before { content: ''; position: absolute; left: -3px; width: 8px; height: 8px; border-radius: 50%; background: var(--paint); box-shadow: 0 0 0 3px var(--ground); top: 50%; margin-top: -4px; }
    .gtoc__a { position: relative; }
  }

  /* ── Under 1200px: a disclosure; with JS, a sticky bar ── */
  @media (max-width: 1199px) {
    .gtoc__d { border-radius: var(--r-panel); background: var(--ground-2); }
    .gtoc__sum { position: relative; display: flex; align-items: center; gap: 12px; min-height: 56px; padding: 0 16px; }
    .gtoc__now { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-display); font-weight: 680; font-size: 0.95rem; }
    :global(.gtoc__chev) { flex: none; transition: rotate var(--t2) var(--ease); }
    .gtoc__d[open] :global(.gtoc__chev) { rotate: 180deg; }
    .gtoc__panel { padding: 4px 16px 18px; }
    .gtoc__title { display: none; }
    .gtoc__a { padding-left: 0; min-height: 44px; align-items: center; }

    .gtoc[data-js] { position: sticky; top: var(--header-h); margin-inline: calc(-1 * var(--gutter)); }
    .gtoc[data-js] .gtoc__d { border-radius: 0; background: rgb(230 224 212 / 0.94); box-shadow: 0 1px 0 var(--line); }
    @supports (backdrop-filter: blur(1px)) { .gtoc[data-js] .gtoc__d { background: rgb(230 224 212 / 0.84); backdrop-filter: saturate(1.3) blur(14px); } }
    .gtoc[data-js] .gtoc__sum { padding-inline: var(--gutter); }
    .gtoc[data-js] .gtoc__panel { position: absolute; left: 0; right: 0; top: 100%; max-height: min(66vh, 560px); overflow-y: auto; overscroll-behavior: contain;
      padding: 8px var(--gutter) 20px; background: var(--ground); box-shadow: 0 1px 0 var(--line), 0 30px 50px -28px rgb(var(--ink-rgb) / 0.5); }
    .gtoc__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--paint); transform-origin: left; }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: --gread) and (timeline-scope: --gread) {
      @keyframes gtoc-read { from { scale: 1 0; } to { scale: 1 1; } }
      @keyframes gtoc-read-x { from { scale: 0 1; } to { scale: 1 1; } }
      @media (min-width: 1200px) {
        .gtoc__list::after { display: block; animation: gtoc-read linear both; animation-timeline: --gread; animation-range: contain 0% contain 100%; }
      }
      @media (max-width: 1199px) {
        .gtoc[data-js] .gtoc__bar { display: block; animation: gtoc-read-x linear both; animation-timeline: --gread; animation-range: contain 0% contain 100%; }
      }
    }
    @media (max-width: 1199px) {
      .gtoc[data-js] .gtoc__d[open] .gtoc__panel { animation: gtoc-drop var(--t3) var(--ease); }
      @keyframes gtoc-drop { from { opacity: 0; translate: 0 -6px; } }
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-gtoc]');
  const d = nav?.querySelector<HTMLDetailsElement>('[data-gtoc-d]');
  if (nav && d) {
    const narrow = matchMedia('(max-width: 1199px)');
    narrow.addEventListener('change', () => { d.open = !narrow.matches; });
    const links = new Map([...nav.querySelectorAll<HTMLAnchorElement>('[data-gtoc-link]')].map((a) => [a.dataset.gtocLink!, a]));
    const now = nav.querySelector<HTMLElement>('[data-gtoc-now]');

    /* close the dropdown after a jump, on Esc, and on a tap outside it */
    nav.addEventListener('click', (e) => { if (narrow.matches && (e.target as HTMLElement).closest('a[href^="#"]')) d.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && narrow.matches && d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
    document.addEventListener('click', (e) => { if (narrow.matches && d.open && !nav.contains(e.target as Node)) d.open = false; });

    /* scroll-spy: the last section whose top has passed the upper third of the screen */
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el)
      .map((h) => (h.closest('[data-gsec]') as HTMLElement | null) ?? h);
    const ids = targets.map((t) => t.dataset.gsec ?? t.id);
    let last = -2;
    const mark = () => {
      const line = window.innerHeight * 0.34;
      let i = -1;
      targets.forEach((t, k) => { if (t.getBoundingClientRect().top < line) i = k; });
      if (i === last) return;
      last = i;
      links.forEach((a) => a.removeAttribute('aria-current'));
      const a = links.get(ids[Math.max(i, 0)]);
      if (a && i >= 0) a.setAttribute('aria-current', 'location');
      if (now && a) now.textContent = a.querySelector('.gtoc__t')?.textContent ?? '';
    };
    let raf = 0;
    addEventListener('scroll', () => { raf ||= requestAnimationFrame(() => { raf = 0; mark(); }); }, { passive: true });
    mark();
  }
</script>
