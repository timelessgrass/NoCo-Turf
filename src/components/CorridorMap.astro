---
/**
 * The Route (motion system M5): Northern Colorado drawn from real coordinates, with the complete town list
 * as its accessible equivalent. Hover or focus a town — in the list or on the map — and a painted route
 * draws out to it from Windsor; with JS off or reduced motion, every route shows faintly and nothing moves.
 * Replaces the old site's card grid, which truncated neighbour lists and put Denver towns next to Fort Collins.
 *
 * Coordinates: Census 2024 Gazetteer internal points (territory.mjs). I-25 and US 34 are schematic lines
 * through their real corridor — this is a locator, not a road map. The boundary note is the ONLY element
 * allowed to name a Denver-metro place (data-boundary; docs/CONTRACTS.md).
 */
import { REGIONS } from '../data/territory.mjs';

interface Town { slug: string; name: string; region: string; tier: string; lat: number; lng: number; draft?: boolean }
interface Props { towns: Town[]; current?: string; compact?: boolean; }
const { towns, current, compact = false } = Astro.props;

const box = { latMax: 40.76, latMin: 40.0, lngMin: -105.22, lngMax: -104.64 };
const K = Math.cos((40.4 * Math.PI) / 180);
const W = 560;
const scale = W / ((box.lngMax - box.lngMin) * K);
const H = Math.round((box.latMax - box.latMin) * scale);
const px = (lng: number, lat: number) => [+((lng - box.lngMin) * K * scale).toFixed(1), +((box.latMax - lat) * scale).toFixed(1)] as const;
const line = (pts: [number, number][]) => pts.map(([lng, lat], i) => `${i ? 'L' : 'M'}${px(lng, lat).join(' ')}`).join(' ');

const hub = towns.find((t) => t.tier === 'hub') ?? towns[0];
const [hx, hy] = px(hub.lng, hub.lat);
const route = (t: Town) => {
  const [x, y] = px(t.lng, t.lat);
  const mx = (hx + x) / 2, my = (hy + y) / 2;
  const dx = x - hx, dy = y - hy; const len = Math.hypot(dx, dy) || 1;
  const bend = Math.min(60, len * 0.22);
  return `M${hx} ${hy} Q${(mx - (dy / len) * bend).toFixed(1)} ${(my + (dx / len) * bend).toFixed(1)} ${x} ${y}`;
};
/* Label side per town, worked out from the projected coordinates so neighbours never collide
   (Johnstown/Milliken, Longmont/Firestone, Fort Collins/Timnath are the tight pairs). */
const RIGHT = ['Wellington', 'Timnath', 'Loveland', 'Milliken', 'Berthoud', 'Mead', 'Longmont', 'Firestone', 'Frederick', 'Dacono'];
const labelSide = (t: Town) => (RIGHT.includes(t.name) ? 'start' : 'end');

const i25 = line([[-104.986, 40.76], [-104.99, 40.6], [-104.985, 40.42], [-104.98, 40.3], [-104.985, 40.16], [-104.99, 40.0]]);
const us34 = line([[-105.22, 40.403], [-105.06, 40.408], [-104.98, 40.41], [-104.78, 40.415], [-104.64, 40.42]]);
const ridge = line([[-105.2, 40.76], [-105.17, 40.66], [-105.19, 40.58], [-105.16, 40.5], [-105.18, 40.42], [-105.15, 40.33], [-105.17, 40.24], [-105.14, 40.14], [-105.16, 40.0]]);
const [, by] = px(-104.9, 40.035);
const regions = Object.entries(REGIONS).map(([key, label]) => ({ key, label, towns: towns.filter((t) => t.region === key) })).filter((r) => r.towns.length);
const routeCss = towns.map((t) => `.cmap:has([data-town="${t.slug}"]:is(:hover,:focus-visible)) [data-route="${t.slug}"]{stroke-dashoffset:0;opacity:1}.cmap:has([data-town="${t.slug}"]:is(:hover,:focus-visible)) [data-dot="${t.slug}"]{fill:var(--paint);r:8}`).join('');
---
<div class:list={['cmap', { 'cmap--compact': compact }]} style={`--map-ar:${W}/${H}`}>
  <svg class="cmap__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="cmap-title">
    <title id="cmap-title">Map of the Northern Colorado towns NoCo Turf Co. covers, from Wellington in the north to Longmont and Dacono in the south</title>
    <path class="cmap__ridge" d={ridge} />
    <text class="cmap__note" x={px(-105.205, 40.63)[0]} y={px(-105.2, 40.63)[1]} transform={`rotate(-90 ${px(-105.205, 40.63).join(' ')})`}>Foothills</text>
    <path class="cmap__road" d={i25} /><text class="cmap__road-label" x={px(-104.982, 40.73)[0] + 6} y={px(-104.982, 40.73)[1]}>I-25</text>
    <path class="cmap__road cmap__road--minor" d={us34} /><text class="cmap__road-label" x={px(-104.68, 40.42)[0] - 30} y={px(-104.68, 40.42)[1] - 8}>US 34</text>
    <g data-boundary>
      <line class="cmap__boundary" x1="0" x2={W} y1={by} y2={by} />
      <text class="cmap__note" x={W / 2} y={by + 22} text-anchor="middle">Denver metro · not covered</text>
    </g>
    {towns.map((t) => <path class="cmap__route" data-route={t.slug} d={route(t)} pathLength="1" />)}
    {towns.map((t) => {
      const [x, y] = px(t.lng, t.lat);
      return (
        <a href={`/areas/${t.slug}/`} data-town={t.slug} class:list={['cmap__town', { 'is-hub': t.tier === 'hub', 'is-current': t.slug === current }]}>
          <circle data-dot={t.slug} cx={x} cy={y} r={t.tier === 'hub' ? 8 : 5.5} />
          <text x={labelSide(t) === 'start' ? x + 12 : x - 12} y={y + 4.5} text-anchor={labelSide(t)}>{t.name}</text>
        </a>
      );
    })}
  </svg>
  {!compact && (
    <div class="cmap__list">
      {regions.map((r) => (
        <div class="cmap__region">
          <p class="label">{r.label}</p>
          <ul>
            {r.towns.map((t) => <li><a href={`/areas/${t.slug}/`} data-town={t.slug} class:list={{ 'is-current': t.slug === current }}>{t.name}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  )}
</div>
<style set:html={routeCss}></style>
<style>
  .cmap { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .cmap--compact { grid-template-columns: 1fr; }
  .cmap__svg { width: 100%; height: auto; max-height: min(88vh, 980px); overflow: visible; background: var(--ground-2); border-radius: var(--r-panel); padding: 18px 10px; }
  .on-slab .cmap__svg { background: var(--slab-2); }
  .cmap__ridge { fill: none; stroke: rgb(var(--ink-rgb) / 0.22); stroke-width: 1.4; stroke-dasharray: 2 5; }
  .cmap__road { fill: none; stroke: rgb(var(--ink-rgb) / 0.3); stroke-width: 3; stroke-linecap: round; }
  .cmap__road--minor { stroke-width: 1.8; stroke: rgb(var(--ink-rgb) / 0.2); }
  .cmap__road-label, .cmap__note { font-family: var(--font-display); font-stretch: 78%; font-weight: 640; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; fill: rgb(var(--ink-rgb) / 0.45); }
  .cmap__boundary { stroke: rgb(var(--ink-rgb) / 0.35); stroke-width: 1.2; stroke-dasharray: 6 6; }
  .cmap__route { fill: none; stroke: var(--paint); stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0;
    transition: stroke-dashoffset var(--t5) var(--ease), opacity var(--t2) var(--ease); }
  .cmap__town { cursor: pointer; }
  .cmap__town circle { fill: var(--ink); stroke: var(--ground-2); stroke-width: 2.5; transition: r var(--t2) var(--ease), fill var(--t2) var(--ease); }
  .cmap__town.is-hub circle { fill: var(--paint); stroke: var(--ink); stroke-width: 2.5; }
  .cmap__town text { font-family: var(--font-display); font-weight: 680; font-stretch: 96%; font-size: 13.5px; fill: var(--ink); paint-order: stroke; stroke: var(--ground-2); stroke-width: 4px; stroke-linejoin: round; }
  .cmap__town.is-hub text { font-weight: 820; font-size: 15px; }
  .cmap__town.is-current circle { fill: var(--paint); r: 8; }
  .cmap__town:focus-visible { outline: none; }
  .cmap__town:focus-visible text { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .cmap__route { transition: none; opacity: 0.35; stroke-dashoffset: 0; } }
  @media (hover: none) { .cmap__route { opacity: 0.4; stroke-dashoffset: 0; } }

  .cmap__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 32px; align-content: start; position: sticky; top: calc(var(--header-h) + 24px); }
  .cmap__region ul { list-style: none; margin-top: 10px; display: grid; }
  .cmap__region a { display: flex; align-items: center; justify-content: space-between; min-height: 44px; border-bottom: 1px solid var(--line);
    font-family: var(--font-display); font-weight: 700; font-stretch: 106%; font-size: 1.12rem; letter-spacing: -0.015em; text-decoration: none;
    transition: padding var(--t2) var(--ease), color var(--t2) var(--ease); }
  .cmap__region a::after { content: ''; width: 14px; height: 2px; background: var(--paint); transform-origin: right; scale: 0 1; transition: scale var(--t2) var(--ease); }
  .cmap__region a:hover, .cmap__region a:focus-visible { padding-left: 6px; }
  .cmap__region a:hover::after, .cmap__region a:focus-visible::after, .cmap__region a.is-current::after { scale: 1 1; }
  @media (max-width: 899px) { .cmap { grid-template-columns: 1fr; } .cmap__svg { max-width: 520px; margin-inline: auto; } }
  @media (max-width: 480px) { .cmap__list { grid-template-columns: 1fr; } }
</style>
