---
/** Towns keep their Census coordinates. Roads are schematic orientation aids;
 * no polygon or border implies coverage beyond the approved town list.
 * HTML town links remain the accessible equivalent; compact callers supply their own list.
 */
import { REGIONS } from '../data/territory.mjs';

interface Town { slug: string; name: string; region: string; tier: string; lat: number; lng: number; draft?: boolean }
interface Props { towns: Town[]; current?: string; compact?: boolean; /** false where the page carries its own boundary note */ boundaryLabel?: boolean; }
const { towns, current, compact = false, boundaryLabel = true } = Astro.props;

// Extra room around the real positions separates labels without moving the towns.
const box = { latMax: 40.74, latMin: 40.035, lngMin: -105.32, lngMax: -104.55 };
const K = Math.cos((40.4 * Math.PI) / 180);
const W = 640;
const scale = W / ((box.lngMax - box.lngMin) * K);
const H = Math.round((box.latMax - box.latMin) * scale);
const px = (lng: number, lat: number) => [+((lng - box.lngMin) * K * scale).toFixed(1), +((box.latMax - lat) * scale).toFixed(1)] as const;
const line = (pts: [number, number][]) => pts.map(([lng, lat], i) => `${i ? 'L' : 'M'}${px(lng, lat).join(' ')}`).join(' ');
const hub = towns.find((t) => t.tier === 'hub');
/* A town beyond the western edge (Estes Park, up US 34 from Loveland) keeps its true latitude and sits on the edge
   with an arrow pointing west, the usual off-map mark, rather than stretching the map for one mountain town. */
const EDGE_X = 22;
const off = (t: Town) => t.lng < box.lngMin;
const at = (t: Town) => (off(t) ? [EDGE_X, px(t.lng, t.lat)[1]] as const : px(t.lng, t.lat));
const mapId = `cmap-${current ?? 'all'}`;

// Phones show the main orientation towns; the list below links every served town.
const leftLabels = new Set(['fort-collins-co', 'loveland-co', 'johnstown-co', 'berthoud-co', 'mead-co', 'longmont-co', 'frederick-co']);
const mobileLabels = new Set(['wellington-co', 'fort-collins-co', 'windsor-co', 'loveland-co', 'greeley-co', 'berthoud-co', 'longmont-co', 'dacono-co', 'estes-park-co']);
const labelOffset: Record<string, number> = { 'johnstown-co': -8, 'berthoud-co': 8, 'severance-co': -4 };
const label = (t: Town) => {
  const [x, y] = at(t);
  const left = leftLabels.has(t.slug) && !off(t);
  return { x: x + (left ? -18 : 18), y: y + (labelOffset[t.slug] ?? 0), anchor: left ? 'end' : 'start' };
};
const i25 = line([[-104.986, 40.74], [-104.99, 40.6], [-104.985, 40.42], [-104.98, 40.3], [-104.985, 40.16], [-104.99, 40.035]]);
const us34 = line([[-105.32, 40.39], [-105.24, 40.403], [-105.06, 40.408], [-104.98, 40.41], [-104.78, 40.415], [-104.59, 40.42]]);
const regionLabels: Record<string, string> = {
  'poudre': 'Fort Collins area',
  'windsor-johnstown': 'Windsor area',
  'loveland-berthoud': 'Loveland area',
  'greeley-east-weld': 'Greeley area',
  'carbon-valley-longmont': 'Longmont & Carbon Valley',
};
const regions = Object.entries(REGIONS).map(([key, name]) => ({
  key, name: regionLabels[key] ?? name,
  towns: towns.filter((t) => t.region === key).sort((a, b) => a.name.localeCompare(b.name)),
})).filter((r) => r.towns.length);
const highlightCss = towns.map((t) => `.cmap:has(.cmap__list [data-town="${t.slug}"]:is(:hover,:focus-visible)) .cmap__town[data-town="${t.slug}"] .cmap__dot{fill:var(--paint);stroke:var(--ink)}.cmap:has(.cmap__list [data-town="${t.slug}"]:is(:hover,:focus-visible)) .cmap__town[data-town="${t.slug}"] text{fill:var(--paint-ink);text-decoration:underline}`).join('');
---
{towns.length > 0 && (
  <div class:list={['cmap', { 'cmap--compact': compact }]}>
    <figure class="cmap__figure">
      <div class="cmap__key">
        {hub && <span><i class="cmap__key-base" aria-hidden="true"></i>Based in {hub.name}</span>}
        <span><i class="cmap__key-town" aria-hidden="true"></i>Towns we serve</span>
      </div>
      <svg class="cmap__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${mapId}-title ${mapId}-desc`}>
        <title id={`${mapId}-title`}>Northern Colorado service towns, from Wellington to Longmont and Dacono</title>
        <desc id={`${mapId}-desc`}>North is at the top. Windsor is our base. I-25 runs north to south, and US 34 runs between Loveland and Greeley.{towns.some(off) && ' Estes Park is off the map to the west, up US 34 from Loveland.'} All {towns.length} towns we serve are linked in the town list.</desc>
        <g aria-hidden="true">
          <path class="cmap__road-edge" d={i25} />
          <path class="cmap__road" d={i25} />
          <path class="cmap__road-edge cmap__road-edge--minor" d={us34} />
          <path class="cmap__road cmap__road--minor" d={us34} />
          <g class="cmap__road-tag" transform={`translate(${px(-104.99, 40.645)[0]} ${px(-104.99, 40.645)[1]})`}>
            <rect x="-30" y="-16" width="60" height="32" rx="6" />
            <text text-anchor="middle" dominant-baseline="central">I-25</text>
          </g>
          <g class="cmap__road-tag cmap__road-tag--minor" transform={`translate(565 ${px(-104.59, 40.42)[1] - 24})`}>
            <rect x="-36" y="-16" width="72" height="32" rx="6" />
            <text text-anchor="middle" dominant-baseline="central">US 34</text>
          </g>
          <g class="cmap__north" transform="translate(572 62)">
            <path d="M0 -27 L-8 -5 L0 -10 L8 -5 Z" />
            <text y="20" text-anchor="middle">N</text>
          </g>
        </g>
        {towns.map((t) => {
          const [x, y] = at(t);
          const pos = label(t);
          return (
            <a href={`/areas/${t.slug}/`} tabindex="-1" aria-hidden="true" data-town={t.slug}
              class:list={['cmap__town', { 'is-hub': t.tier === 'hub', 'is-current': t.slug === current, 'is-mobile-label': mobileLabels.has(t.slug) || t.slug === current }]}>
              <circle class="cmap__hit" cx={x} cy={y} r="22" />
              {t.tier === 'hub' && <circle class="cmap__hub-ring" cx={x} cy={y} r="18" />}
              <circle class="cmap__dot" data-dot={t.slug} cx={x} cy={y} r={t.tier === 'hub' ? 11 : 7} />
              {off(t) && <path class="cmap__west" d={`M${x - 12} ${y} l7 -5 v10 z`} />}
              <text x={pos.x} y={pos.y} text-anchor={pos.anchor} dominant-baseline="central">{t.name}</text>
            </a>
          );
        })}
      </svg>
      <figcaption class="cmap__caption">
        <span class="cmap__caption-desktop">Select a town on the map or in the list.</span>
        <span class="cmap__caption-mobile">{compact ? `All ${towns.length} towns are listed on this page.` : `Find all ${towns.length} towns in the list below.`}</span>
        {boundaryLabel && <span class="cmap__boundary" data-boundary>Denver metro is outside our service area.</span>}
      </figcaption>
    </figure>
    {!compact && <div class="cmap__list" aria-label="Towns served, grouped by area">
      {regions.map((r) => (
        <div class="cmap__region">
          <h3>{r.name}</h3>
          <ul role="list">
            {r.towns.map((t) => <li><a href={`/areas/${t.slug}/`} data-town={t.slug} aria-current={t.slug === current ? 'page' : undefined} class:list={{ 'is-current': t.slug === current }}>{t.name}<span aria-hidden="true">↗</span></a></li>)}
          </ul>
        </div>
      ))}
    </div>}
  </div>
)}
<style set:html={highlightCss}></style>
<style>
  .cmap__west { fill: currentColor; opacity: 0.55; }
  .cmap { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(28px, 3.5vw, 48px); align-items: start; }
  .cmap--compact { grid-template-columns: 1fr; }
  .cmap__figure { margin: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--r-panel); background: var(--ground-2); }
  .on-slab .cmap__figure { background: var(--slab-2); }
  .cmap__key { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; padding: 18px 22px; border-bottom: 1px solid var(--line); font-size: 0.9rem; font-weight: 600; }
  .cmap__key span { display: inline-flex; align-items: center; gap: 10px; }
  .cmap__key i { display: block; flex: none; border-radius: 50%; }
  .cmap__key-base { width: 12px; height: 12px; background: var(--paint); outline: 1.5px solid var(--ink); outline-offset: 3px; }
  .cmap__key-town { width: 8px; height: 8px; background: var(--ink); }
  .cmap__svg { display: block; width: 100%; height: auto; }
  .cmap__road-edge { fill: none; stroke: rgb(var(--ink-rgb) / 0.18); stroke-width: 12; }
  .cmap__road { fill: none; stroke: var(--ground); stroke-width: 8; }
  .cmap__road-edge--minor { stroke-width: 8; }
  .cmap__road--minor { stroke-width: 5; }
  .cmap__road-tag rect { fill: var(--ground); stroke: rgb(var(--ink-rgb) / 0.35); stroke-width: 1.5; }
  .cmap__road-tag text { font-family: var(--font-body); font-size: 18px; font-weight: 700; fill: var(--ink-2); }
  .cmap__north { fill: var(--ink-2); }
  .cmap__north text { font-family: var(--font-body); font-size: 21px; font-weight: 650; }
  .cmap__town { cursor: pointer; }
  .cmap__hit { fill: transparent; stroke: none; }
  .cmap__dot { fill: var(--ink); stroke: var(--ground-2); stroke-width: 3; transition: fill var(--t2) var(--ease); }
  .cmap__town.is-hub .cmap__dot, .cmap__town.is-current .cmap__dot { fill: var(--paint); stroke: var(--ink); stroke-width: 2; }
  .cmap__hub-ring { fill: none; stroke: var(--paint-ink); stroke-width: 1.5; }
  .cmap__town text { font-family: var(--font-display); font-weight: 650; font-size: 20px; fill: var(--ink); paint-order: stroke; stroke: var(--ground-2); stroke-width: 6px; stroke-linejoin: round; }
  .cmap__town.is-hub text { font-weight: 800; font-size: 22px; }
  .cmap__town:hover .cmap__dot { fill: var(--paint); stroke: var(--ink); }
  .cmap__town:hover text { text-decoration: underline; }
  .cmap--compact .cmap__town text { display: none; }
  .cmap--compact .cmap__town.is-mobile-label text { display: block; font-size: 30px; }
  .cmap--compact .cmap__town.is-hub text { font-size: 32px; }
  .cmap__caption { display: grid; gap: 6px; padding: 16px 22px 18px; border-top: 1px solid var(--line); font-size: 0.875rem; line-height: 1.5; color: var(--ink-2); }
  .cmap__caption-mobile { display: none; }
  .cmap__boundary { font-size: 0.8125rem; }
  .cmap__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
  .cmap__region h3 { margin: 0 0 10px; padding-bottom: 12px; border-bottom: 2px solid var(--ink); font-family: var(--font-body); font-size: 1rem; line-height: 1.45; font-weight: 700; letter-spacing: 0; }
  .cmap__region ul { list-style: none; display: grid; }
  .cmap__region a { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 48px; padding: 9px 0; border-bottom: 1px solid var(--line); font-family: var(--font-display); font-weight: 650; font-size: 1.0625rem; letter-spacing: -0.015em; text-decoration: none; }
  .cmap__region a span { font-family: var(--font-body); color: var(--ink-3); font-size: 0.9rem; }
  .cmap__region a:hover, .cmap__region a:focus-visible, .cmap__region a.is-current { color: var(--paint-ink); text-decoration: underline; text-underline-offset: 4px; }
  .cmap__region a:focus-visible { outline: 2px solid var(--paint-ink); outline-offset: 3px; border-radius: 2px; }
  .cmap__region:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .cmap__region:last-child:nth-child(odd) ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 28px; }
  @media (max-width: 1049px) { .cmap { grid-template-columns: 1fr; } .cmap__figure { width: 100%; max-width: 640px; margin-inline: auto; } }
  @media (max-width: 699px) {
    .cmap__key { padding: 16px; gap: 10px 18px; font-size: 0.8125rem; }
    .cmap__town { pointer-events: none; }
    .cmap__town text { display: none; }
    .cmap__town.is-mobile-label text { display: block; font-size: 30px; }
    .cmap__town.is-hub text { font-size: 32px; }
    .cmap__road-tag text { font-size: 24px; }
    .cmap__road-tag--minor { display: none; }
    .cmap__north text { font-size: 28px; }
    .cmap__caption { padding: 14px 16px 16px; }
    .cmap__caption-desktop { display: none; }
    .cmap__caption-mobile { display: block; }
    .cmap__list { gap: 24px 20px; }
    .cmap__region h3 { font-size: 0.9375rem; }
    .cmap__region a { min-height: 48px; font-size: 1rem; }
    .cmap__region:last-child:nth-child(odd) ul { column-gap: 20px; }
  }
  @media (prefers-reduced-motion: reduce) { .cmap__dot { transition: none; } }
</style>
