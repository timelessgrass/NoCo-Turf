const paths: Record<string, string> = {
  phone: '<path d="M6.6 3.5h2.6l1.5 4-2 1.3a11 11 0 0 0 6.5 6.5l1.3-2 4 1.5v2.6a2.1 2.1 0 0 1-2.3 2.1C10.9 19 5 13.1 4.5 5.8a2.1 2.1 0 0 1 2.1-2.3Z"/>',
  arrow: '<path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5"/>',
  'arrow-down': '<path d="M12 4v15M6.5 13.5 12 19l5.5-5.5"/>',
  menu: '<path d="M3.5 7h17M3.5 12h17M3.5 17h11"/>',
  close: '<path d="M5.5 5.5l13 13M18.5 5.5l-13 13"/>',
  chevron: '<path d="m7 9.5 5 5 5-5"/>',
  pin: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  play: '<path d="M8 5.5v13l10.5-6.5Z"/>',
