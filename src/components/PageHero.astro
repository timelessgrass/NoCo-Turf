---
/**
 * Inner-page opener. Two variants:
 *   plain  — ground, big title, lede, crumbs (guides, legal, hubs)
 *   photo  — split: title block left, a real job photo right with its record line (services, towns, about)
 * Every page also gets the visible breadcrumb trail (BreadcrumbList JSON-LD is emitted by Base from the
 * same crumbs). The H1 is a claim, 9–13 words on interior pages (copy.md); the payoff slot is optional.
 */
import Crumbs from './Crumbs.astro';
import Photo from './Photo.astro';
type P = { src: ImageMetadata; alt: string; focus?: string; caption?: string; place?: string };

interface Props {
  label: string;
  crumbs: { name: string; path: string }[];
  photo?: P | null;
  lede?: string;
  compact?: boolean;
  /** false hides the photo's record line: a scene, or a job photo taken somewhere other than this page's place */
  caption?: boolean;
}
const { label, crumbs, photo, lede, compact = false, caption = true } = Astro.props;
---
<section class:list={['ph', { 'ph--photo': photo, 'ph--compact': compact }]}>
  <div class="wrap ph__grid">
    <div class="ph__copy">
      <Crumbs crumbs={crumbs} />
      <p class="label ph__label">{label}</p>
      <h1 class="ph__h1"><slot /></h1>
      {lede && <p class="lede ph__lede">{lede}</p>}
      <slot name="after" />
    </div>
    {photo && (
      <figure class="ph__fig develop">
        <div class="ph__frame drift"><Photo photo={photo} eager sizes="(max-width: 899px) 100vw, 48vw" widths={[640, 960, 1280, 1600]} /></div>
        {caption && photo.caption && <figcaption><span>{photo.caption}</span>{photo.place && <span class="ph__rec">{photo.place}</span>}</figcaption>}
      </figure>
    )}
  </div>
</section>

<style>
  .ph { padding-block: clamp(36px, 5vw, 72px) clamp(48px, 6vw, 96px); border-bottom: 1px solid var(--line); }
  .ph__grid { display: grid; gap: clamp(28px, 5vw, 80px); }
  .ph--photo .ph__grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: end; }
  .ph__label { margin: 28px 0 16px; }
  /* Interior H1s run 9–13 words (copy.md), so they sit well below the homepage's display size. */
  .ph__h1 { font-size: clamp(2.2rem, 1.35rem + 2.9vw, 4.15rem); font-stretch: 114%; letter-spacing: -0.036em; line-height: 0.98; max-width: 17ch; }
  .ph--compact .ph__h1 { font-size: clamp(2.05rem, 1.3rem + 2.5vw, 3.7rem); max-width: 19ch; }
  .ph__lede { margin-top: 22px; max-width: 52ch; }
  .ph__fig { margin: 0; }
  .ph__frame { overflow: hidden; border-radius: var(--r-photo); }
  .ph__fig :global(img) { display: block; width: 100%; aspect-ratio: 4 / 3.3; object-fit: cover; }
  .ph__fig figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding-top: 10px; font-size: var(--fs-small); font-weight: 600; }
  .ph__rec { font-weight: 400; color: var(--ink-3); }
  .ph__rec::first-letter { text-transform: uppercase; }
  @media (max-width: 899px) { .ph--photo .ph__grid { grid-template-columns: 1fr; } }
</style>
