---
/**
 * The one form (exactly one <form> per page). Field NAMES are the lead contract (docs/CONTRACTS.md) —
 * RED under aftercare: never rename without changing netlify/functions/lib/lead-routing.mjs and its tests.
 * Posts to /.netlify/functions/lead. Without JS: a plain POST → 303 /thanks/ (or the call-us page on failure).
 * With JS: stays on the page, keeps every answer on failure, shows the phone on 502, asks for a phone on 422.
 * No upload field (photos are asked for by text on /thanks/), no CAPTCHA (honeypot + elapsed_ms).
 * Field set is PROVISIONAL until matched to Brian's own intake questions (Appendix A #10).
 */
import Icon from './Icon.astro';
import { visibleServices } from '../data/services';
import { NOCO_TOWNS } from '../data/territory.mjs';
import { phoneHref, phoneDisplay } from '../data/brief';

interface Props { town?: string; use?: string; tone?: 'slab' | 'ground'; id?: string; }
const { town, use, tone = 'slab', id = 'estimate' } = Astro.props;
const uses = [...visibleServices.map((s) => ({ value: s.formUse, label: s.name })), { value: 'Not sure', label: 'Not sure yet' }];
const sizes = ['Under 300 sq ft', '300 to 800 sq ft', '800 to 1,500 sq ft', 'Over 1,500 sq ft', 'Not sure — measure at the visit'];
const towns = [...NOCO_TOWNS].sort((a, b) => a.name.localeCompare(b.name));
---
<form class:list={['ef', `ef--${tone}`]} id={id} method="post" action="/.netlify/functions/lead" data-ef novalidate>
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="elapsed_ms" value="" data-elapsed />
  <div class="ef__trap" aria-hidden="true"><label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>

  <fieldset class="ef__set">
    <legend class="ef__legend"><span class="ef__n num">1</span>The yard</legend>
    <p class="ef__q" id={`${id}-use`}>What's it for? <span>Pick any</span></p>
    <div class="ef__chips" role="group" aria-labelledby={`${id}-use`}>
      {uses.map((u) => (
        <label class="chip"><input type="checkbox" name="use" value={u.value} checked={use === u.value} /><span>{u.label}</span></label>
      ))}
    </div>
    <div class="ef__row">
      <label class="ef__field">
        <span class="ef__label">Town</span>
        <select name="town" autocomplete="address-level2">
          <option value="">Choose your town</option>
          {towns.map((t) => <option value={t.name} selected={town === t.name}>{t.name}</option>)}
          <option value="Somewhere else">Somewhere else</option>
        </select>
      </label>
      <label class="ef__field ef__field--zip">
        <span class="ef__label">ZIP <span class="ef__opt">optional</span></span>
        <input name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="5" pattern="[0-9]{5}" />
      </label>
    </div>
    <p class="ef__q" id={`${id}-size`}>Roughly how big?</p>
    <div class="ef__chips" role="radiogroup" aria-labelledby={`${id}-size`}>
      {sizes.map((s) => <label class="chip chip--radio"><input type="radio" name="size" value={s} /><span>{s}</span></label>)}
    </div>
  </fieldset>

  <fieldset class="ef__set">
    <legend class="ef__legend"><span class="ef__n num">2</span>Timing</legend>
    <div class="ef__two">
      <div>
        <p class="ef__q" id={`${id}-hoa`}>Is there an HOA?</p>
        <div class="ef__chips" role="radiogroup" aria-labelledby={`${id}-hoa`}>
          {['Yes', 'No', 'Not sure'].map((v) => <label class="chip chip--radio"><input type="radio" name="hoa" value={v} /><span>{v}</span></label>)}
        </div>
      </div>
      <div>
        <p class="ef__q" id={`${id}-when`}>When?</p>
        <div class="ef__chips" role="radiogroup" aria-labelledby={`${id}-when`}>
          {['As soon as possible', 'In the next few months', 'Just pricing it out'].map((v) => <label class="chip chip--radio"><input type="radio" name="timeline" value={v} /><span>{v}</span></label>)}
        </div>
      </div>
    </div>
  </fieldset>

  <fieldset class="ef__set">
    <legend class="ef__legend"><span class="ef__n num">3</span>How to reach you</legend>
    <div class="ef__row">
      <label class="ef__field"><span class="ef__label">Name</span><input name="name" autocomplete="name" required /></label>
      <label class="ef__field"><span class="ef__label">Phone</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" required /></label>
    </div>
    <div class="ef__row">
      <label class="ef__field"><span class="ef__label">Email <span class="ef__opt">optional</span></span><input name="email" type="email" inputmode="email" autocomplete="email" /></label>
      <div class="ef__field">
        <span class="ef__label" id={`${id}-pref`}>Best way to reach you</span>
        <div class="ef__chips" role="radiogroup" aria-labelledby={`${id}-pref`}>
          {['Call', 'Text'].map((v, i) => <label class="chip chip--radio"><input type="radio" name="contact_pref" value={v} checked={i === 0} /><span>{v}</span></label>)}
        </div>
      </div>
    </div>
    <label class="ef__field"><span class="ef__label">How did you hear about us? <span class="ef__opt">optional</span></span>
      <select name="heard">
        <option value="">—</option>
        {['Google search', 'Google Maps', 'ChatGPT or another AI assistant', 'Facebook or Instagram', 'A neighbor or friend', 'Saw a yard we did', 'Other'].map((h) => <option>{h}</option>)}
      </select>
    </label>
  </fieldset>

  <div class="ef__submit">
    <button class="btn btn--paint ef__btn" type="submit" data-cta="form-submit">Book a yard walk <Icon name="arrow" /></button>
    <p class="ef__fine">Northern Colorado only — Wellington to Longmont, Loveland to Eaton.</p>
    {phoneHref && <p class="ef__hatch">Rather talk it through? <a href={phoneHref} data-cta="form-call">Call {phoneDisplay}</a></p>}
    <div class="ef__status" role="status" aria-live="polite" data-ef-status></div>
  </div>
</form>

<style>
  .ef { display: grid; gap: 28px; }
  .ef__trap { position: absolute; left: -9999px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .ef__set { border: 0; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ef__legend { display: flex; align-items: center; gap: 12px; padding: 0; margin-bottom: 4px; font-family: var(--font-display); font-weight: 780; font-stretch: 110%; font-size: 1.35rem; letter-spacing: -0.025em; }
  .ef__n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--paint); color: var(--ink); font-size: 0.9rem; font-weight: 800; }
  .ef__q, .ef__label { display: block; margin: 0 0 8px; font-family: var(--font-display); font-weight: 650; font-stretch: 96%; font-size: 0.98rem; }
  .ef__q span, .ef__opt { font-family: var(--font-body); font-weight: 400; font-size: 0.85rem; opacity: 0.62; margin-left: 6px; }
  .ef__row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .ef__two { display: grid; grid-template-columns: auto 1fr; gap: 14px 28px; }
  .ef__field--zip { max-width: 180px; }
  .ef__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; display: inline-flex; }
  .chip input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .chip span { display: inline-flex; align-items: center; min-height: 44px; padding: 0 16px; border-radius: var(--r-chip); font-size: 0.95rem; font-weight: 550;
    box-shadow: inset 0 0 0 1.5px var(--chip-line); transition: background var(--t2) var(--ease), box-shadow var(--t2) var(--ease), color var(--t2) var(--ease), transform var(--t1) var(--ease); user-select: none; }
  .chip input:hover + span { box-shadow: inset 0 0 0 1.5px var(--paint); }
  .chip input:active + span { transform: scale(0.97); }
  .chip input:checked + span { background: var(--paint); color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--paint); }
  .chip input:focus-visible + span { outline: 3px solid var(--paint); outline-offset: 2px; }
  input:not([type='checkbox']):not([type='radio']), select {
    width: 100%; min-height: 52px; padding: 0 14px; border-radius: var(--r-control); border: 0; font: 500 16px/1.2 var(--font-body);
    background: var(--field-bg); color: inherit; box-shadow: inset 0 0 0 1.5px var(--chip-line); transition: box-shadow var(--t2) var(--ease);
    appearance: none; -webkit-appearance: none; }
  select { background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 20px) 50%, calc(100% - 14px) 50%; background-size: 6px 6px; background-repeat: no-repeat; padding-right: 36px; }
  input:focus, select:focus { outline: none; box-shadow: inset 0 0 0 2px var(--paint); }
  input[aria-invalid='true'] { box-shadow: inset 0 0 0 2px var(--paint); }
  .ef--slab { --chip-line: rgb(var(--bone-rgb) / 0.3); --field-bg: rgb(var(--bone-rgb) / 0.06); color: var(--bone); }
  .ef--slab select option { color: var(--ink); }
  .ef--ground { --chip-line: rgb(var(--ink-rgb) / 0.22); --field-bg: rgb(255 255 255 / 0.45); }
  .ef__submit { display: grid; gap: 10px; justify-items: start; padding-top: 6px; }
  .ef__btn { min-height: 58px; font-size: 1.1rem; padding: 0 28px; }
  .ef__fine, .ef__hatch { margin: 0; font-size: var(--fs-small); opacity: 0.8; }
  .ef__status:empty { display: none; }
  .ef__status { padding: 12px 14px; border-radius: var(--r-control); background: rgb(var(--paint-rgb) / 0.16); font-weight: 550; }
  .ef[data-busy] .ef__btn { opacity: 0.7; pointer-events: none; }
  @media (max-width: 640px) { .ef__row, .ef__two { grid-template-columns: 1fr; } .ef__field--zip { max-width: none; } .ef__btn { width: 100%; } }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-ef]').forEach((form) => {
    const t0 = performance.now();
    const elapsed = form.querySelector<HTMLInputElement>('[data-elapsed]')!;
    const status = form.querySelector<HTMLElement>('[data-ef-status]')!;
    const phoneLink = form.querySelector<HTMLAnchorElement>('.ef__hatch a');
    form.addEventListener('submit', async (e) => {
      elapsed.value = String(Math.round(performance.now() - t0));
      const tel = form.elements.namedItem('phone') as HTMLInputElement;
      if (!tel.value.trim()) {
        e.preventDefault();
        tel.setAttribute('aria-invalid', 'true'); tel.focus();
        status.textContent = 'Add a phone number so we can call you back.';
        return;
      }
      tel.removeAttribute('aria-invalid');
      if (!window.fetch) return; // plain POST
      e.preventDefault();
      form.setAttribute('data-busy', '');
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) { location.href = '/thanks/'; return; }
        if (res.status === 422) { status.textContent = 'Add a phone number or email so we can reach you.'; tel.focus(); }
        else status.innerHTML = phoneLink ? `We couldn't send that just now — your answers are still here. <a href="${phoneLink.href}">Call ${phoneLink.textContent?.replace(/^Call\s*/, '')}</a> and we'll take it by phone.` : "We couldn't send that just now — your answers are still here. Please try again.";
      } catch {
        status.textContent = "We couldn't reach the server — your answers are still here. Please try again, or call us.";
      } finally {
        form.removeAttribute('data-busy');
      }
    });
  });
</script>
