---
/**
 * TownJobs — Brian's own job photos whose camera originals place them near this town (src/data/photos.ts),
 * after the one the hero already shows. Each frame keeps its record line: what, where, when. Desktop: an
 * editorial grid sized by count; mobile: a snap strip. No photo is ever shown on a town it wasn't taken near.
 */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { monthLabel, type Photo as P } from '../data/photos';
import { numberWord } from './TownData';
interface Props { photos: P[]; town: string }
const { photos, town } = Astro.props;
const SPANS: Record<number, number[]> = { 1: [12], 2: [7, 5], 3: [6, 3, 3], 4: [7, 5, 6, 6], 5: [7, 5, 4, 4, 4], 6: [7, 5, 4, 4, 4, 12] };
const spans = SPANS[Math.min(photos.length, 6)] ?? photos.map(() => 4);
---
{photos.length > 0 && (
  <section class="section ground-2 tjobs" id="jobs" aria-labelledby="jobs-h">
    <div class="wrap">
      <header class="tjobs__head">
        <div>
          <h2 id="jobs-h" class="tjobs__h">Yards we’ve built near {town}.</h2>
        </div>
        <p class="lede tjobs__lede">A few recent yards we’ve built in and around {town}.</p>
      </header>
      <ol class="tjobs__grid" role="list">
        {photos.map((p, i) => (
          <li class="tjobs__item" data-span={spans[i] ?? 4}>
            <figure>
              <div class="tjobs__frame develop"><Photo photo={p} sizes={spans[i] >= 7 ? '(max-width: 899px) 84vw, 58vw' : '(max-width: 899px) 84vw, 40vw'} widths={[480, 800, 1200, 1600]} /></div>
              <figcaption>
                <span class="tjobs__no num">{String(i + 1).padStart(2, '0')}</span>
                <span class="tjobs__cap">{p.caption}</span>
                <span class="tjobs__rec">{p.place}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
      <p class="tjobs__all"><a class="btn btn--ink" href="/work/">See all the work <Icon name="arrow" /></a></p>
    </div>
  </section>
)}

<style>
  .tjobs__head { display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px 64px; align-items: end; margin-bottom: clamp(32px, 4vw, 60px); }
  .tjobs__h { margin-top: 14px; font-size: clamp(2rem, 1.2rem + 3vw, 3.8rem); max-width: 17ch; }
  .tjobs__lede { margin: 0; }
  .tjobs__grid { list-style: none; display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(14px, 1.6vw, 24px); }
  .tjobs__item { grid-column: span 4; }
  .tjobs__item[data-span='3'] { grid-column: span 3; } .tjobs__item[data-span='5'] { grid-column: span 5; } .tjobs__item[data-span='6'] { grid-column: span 6; }
  .tjobs__item[data-span='7'] { grid-column: span 7; } .tjobs__item[data-span='12'] { grid-column: span 12; }
  .tjobs__item figure { margin: 0; }
  .tjobs__frame { overflow: hidden; border-radius: var(--r-photo); background: var(--ground); aspect-ratio: 4 / 3; }
  .tjobs__item[data-span='7'] .tjobs__frame { aspect-ratio: 16 / 10; }
  .tjobs__item[data-span='12'] .tjobs__frame { aspect-ratio: 16 / 7; }
  .tjobs__item[data-span='5'] .tjobs__frame { aspect-ratio: 16 / 13.7; }
  .tjobs__frame :global(img) { width: 100%; height: 100%; object-fit: cover; transition: scale var(--t4) var(--ease); }
  .tjobs__frame:hover :global(img) { scale: 1.03; }
  figcaption { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; padding-top: 10px; font-size: var(--fs-small); }
  .tjobs__no { grid-row: span 2; font-family: var(--font-display); font-weight: 800; font-stretch: 110%; color: var(--ink-3); font-size: 0.95rem; }
  .tjobs__cap { font-weight: 600; }
  .tjobs__rec { color: var(--ink-3); font-size: 0.85rem; }
  .tjobs__rec::first-letter { text-transform: uppercase; }
  .tjobs__all { margin: clamp(28px, 3.5vw, 48px) 0 0; }
  @media (max-width: 899px) {
    .tjobs__head { grid-template-columns: 1fr; }
    .tjobs__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 84%; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
      padding-inline: var(--gutter); margin-inline: calc(-1 * var(--gutter)); scroll-padding-inline: var(--gutter); scrollbar-width: none; }
    .tjobs__grid::-webkit-scrollbar { display: none; }
    .tjobs__item, .tjobs__item[data-span] { grid-column: auto; scroll-snap-align: start; }
    .tjobs__frame, .tjobs__item[data-span] .tjobs__frame { aspect-ratio: 4 / 4.4; }
    .tjobs__grid:has(> :only-child) { grid-auto-columns: 100%; }
  }
</style>
