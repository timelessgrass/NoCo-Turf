---
/**
 * Spine beat 9 — the footer is the internal-link backbone: every service, every town by region, every
 * guide topic's hub (not every guide: the hubs list those, so the footer stays the same size at a hundred
 * guides), the company pages and the legal pages (real pages, never "#"). Also the no-JS target of the
 * mobile Menu link (#site-index). NAP renders only from renderable brief facts; the address stays a
 * hole until Brian decides storefront vs service area.
 */
import Icon from './Icon.astro';
import { visibleServices } from '../data/services';
import { visibleTowns, visibleTopics, townsByRegion } from '../lib/visible';
import brief, { fact, businessName, legalName, phoneHref, phoneDisplay, socialProfiles } from '../data/brief';

const towns = await visibleTowns();
const regions = townsByRegion(towns);
const topics = await visibleTopics();
const reg = fact<{ sos_id: string; lookup_url: string }>(brief.identity?.registration);
const year = new Date().getFullYear();
---
<footer class="ftr on-slab" id="site-index">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <a class="ftr__word" href="/">NoCo Turf<span> Co.</span></a>
      <p class="ftr__line">Artificial turf, putting greens and play yards across Northern Colorado — Wellington to Longmont, Loveland to Eaton.</p>
      {phoneHref && <a class="btn btn--paint ftr__call" href={phoneHref} data-cta="footer-call"><Icon name="phone" />Call <span class="btn__num">{phoneDisplay}</span></a>}
      {socialProfiles.length > 0 && (
        <ul class="ftr__social">
          {socialProfiles.map((p) => <li><a href={p.url} rel="noopener">{p.network === 'Google Business Profile' ? 'Google' : p.network}<Icon name="external" size={14} /></a></li>)}
        </ul>
      )}
    </div>

    <nav class="ftr__col" aria-label="Services">
      <p class="label">Services</p>
      <ul>
        {visibleServices.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
        <li><a href="/services/">All services</a></li>
      </ul>
    </nav>

    <nav class="ftr__col ftr__col--areas" aria-label="Areas">
      <p class="label">Areas</p>
      {regions.map((r) => (
        <div class="ftr__region">
          <p>{r.label}</p>
          <ul class="ftr__inline">{r.towns.map((t) => <li><a href={`/areas/${t.slug}/`}>{t.name}</a></li>)}</ul>
        </div>
      ))}
    </nav>

    <nav class="ftr__col" aria-label="Guides and company">
      {topics.length > 0 && <>
        <p class="label">Guides</p>
        <ul>
          {topics.map((t) => <li><a href={`/guides/${t.slug}/`}>{t.label}</a></li>)}
          <li><a href="/guides/">All guides</a></li>
        </ul>
      </>}
      <p class="label ftr__gap">Company</p>
      <ul>
        <li><a href="/work/">Work</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
  </div>

  <div class="wrap ftr__legal">
    <p>© {year} {legalName ?? businessName ?? 'NoCo Turf Co.'}{reg && <> · Colorado SOS ID <a href={reg.lookup_url} rel="noopener">{reg.sos_id}</a></>}</p>
    <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · Site by To The Max Media</p>
  </div>
</footer>

<style>
  .ftr { padding-block: clamp(64px, 6vw + 32px, 120px) calc(28px + var(--bar-h)); }
  .ftr__grid { display: grid; grid-template-columns: 1.3fr 1fr 1.6fr 1.1fr; gap: 40px 48px; }
  .ftr__word { font-family: var(--font-display); font-weight: 840; font-stretch: 122%; font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem); letter-spacing: -0.045em; text-decoration: none; line-height: 0.95; white-space: nowrap; }
  .ftr__word span { font-weight: 500; font-stretch: 100%; opacity: 0.6; }
  .ftr__line { color: var(--bone-2); margin: 16px 0 22px; max-width: 34ch; }
  .ftr__call { margin-bottom: 22px; }
  .ftr__social { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .ftr__social a { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; font-size: var(--fs-small); color: var(--bone-2); text-decoration: none; }
  .ftr__social a:hover { color: var(--bone); }
  .ftr__col ul { list-style: none; display: grid; gap: 2px; margin-top: 12px; }
  .ftr__col a { display: inline-block; padding: 6px 0; color: var(--bone-2); text-decoration: none; font-size: var(--fs-small); }
  .ftr__col a:hover { color: var(--bone); text-decoration: underline; text-decoration-color: var(--paint); }
  .ftr__gap { margin-top: 28px; }
  .ftr__region { margin-top: 12px; }
  .ftr__region > p { font-family: var(--font-display); font-weight: 680; font-size: 0.9rem; margin: 0; color: var(--bone); }
  .ftr__inline { display: flex !important; flex-wrap: wrap; gap: 0 14px !important; margin-top: 0 !important; }
  .ftr__legal { margin-top: clamp(48px, 5vw, 88px); padding-top: 22px; border-top: 1px solid var(--bone-line); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; color: var(--bone-3); font-size: 0.85rem; }
  .ftr__legal p { margin: 0; }
  .ftr__legal a { color: var(--bone-2); }
  @media (max-width: 1099px) { .ftr__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 599px) { .ftr__grid { grid-template-columns: 1fr; } }
</style>
