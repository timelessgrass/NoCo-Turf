---
/**
 * Section head for the company pages (about, contact, work, legal, utility) — the homepage's `.shead` /
 * `.shead--split` pattern, as a component so every page keeps the same rhythm: an annotation label, an H2
 * that is a sentence with a period, and an optional lede. `split` puts the lede beside the title on desktop.
 */
interface Props {
  /** shown only on dark (paint) sections; light sections let the H2 speak (improve 2026-09-28) */
  label?: string;
  id: string;
  lede?: string;
  split?: boolean;
  /** the label in paint (dark slab sections only — never small paint text on the light ground) */
  paint?: boolean;
  class?: string;
}
const { label, id, lede, split = false, paint = false, class: cls } = Astro.props;
---
<header class:list={['co-head', { 'co-head--split': split }, cls]}>
  <div class="co-head__title">
    {paint && label && <p class="label label--paint">{label}</p>}
    <h2 id={id}><slot /></h2>
  </div>
  {lede && <p class="lede">{lede}</p>}
  <slot name="after" />
</header>

<style>
  .co-head { display: grid; gap: 16px; margin-bottom: clamp(36px, 5vw, 72px); }
  .co-head__title { display: grid; gap: 16px; }
  .co-head h2 { max-width: 16ch; }
  .co-head .lede { margin: 0; }
  .co-head--split { grid-template-columns: 1.2fr 1fr; align-items: end; gap: 24px 64px; }
  @media (max-width: 899px) { .co-head--split { grid-template-columns: 1fr; } }
</style>
