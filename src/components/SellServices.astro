---
/**
 * SellServices — "What we build": one card per visible service, with Brian's photo where one honestly
 * shows that kind of job (services.ts `photo`) and the service glyph where none does. A card links to this
 * town's page for that service when it exists in this build, else to the service page.
 */
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { visibleServices } from '../data/services';
import { photo as photoById } from '../data/photos';
import { scene, SERVICE_SCENE } from '../data/scenes';

interface Props { town?: string; townPages?: { service: { slug: string }; path: string }[]; id?: string; heading?: string }
const { townPages = [], id = 'build', heading } = Astro.props;
const BENEFIT: Record<string, string> = {
  'artificial-turf-installation': 'A lawn that stays green all year. No mowing, no watering, no mud.',
  'pet-turf': 'Drains fast and rinses clean, so the dogs get a yard and you get your grass back.',
  'putting-greens': 'Practice at home, with the cups and the break right where you want them.',
  'playground-turf': 'Soft and clean under the swing set, with padding for falls.',
  'commercial-turf': 'Play areas, dog parks and fields for HOAs, parks and schools.',
};
const GO: Record<string, string> = { 'artificial-turf-installation': 'turf lawns', 'pet-turf': 'dog runs', 'putting-greens': 'putting greens', 'playground-turf': 'playground turf', 'commercial-turf': 'commercial and HOA turf' };
/* No photo yet that honestly shows this kind of job: a set word instead of a stand-in picture. */
const WORD: Record<string, string> = { 'pet-turf': 'Dog yards', 'commercial-turf': 'HOA & sports', 'playground-turf': 'Play yards', 'putting-greens': 'Greens', 'artificial-turf-installation': 'Lawns' };
const cards = visibleServices.map((s) => {
  const own = townPages.find((p) => p.service.slug === s.slug);
  return { slug: s.slug, name: s.name, benefit: BENEFIT[s.slug] ?? s.short, href: own?.path ?? `/services/${s.slug}/`, ph: s.photo ? photoById(s.photo) : SERVICE_SCENE[s.slug] ? scene(SERVICE_SCENE[s.slug]) : null };
});
---
<section class="section sv" id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap">
    <header class="sv__head">
      <h2 id={`${id}-h`}>{heading ?? 'What we build.'}</h2>
    </header>
    <ul class="sv__grid stagger" role="list">
      {cards.map((c) => (
        <li>
          <a class="sv__card" href={c.href}>
            <span class="sv__img">{c.ph ? <Photo photo={c.ph} sizes="(max-width: 699px) 90vw, (max-width: 1099px) 45vw, 22vw" widths={[480, 800]} /> : <span class="sv__word" aria-hidden="true">{WORD[c.slug] ?? c.name}</span>}</span>
            <span class="sv__body">
              <strong class="sv__name">{c.name}</strong>
              <span class="sv__line">{c.benefit}</span>
              <span class="sv__go">See {GO[c.slug] ?? c.name} <Icon name="arrow" size={16} /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sv__head { display: grid; gap: 14px; max-width: 780px; margin-bottom: clamp(28px, 4vw, 52px); }
  .sv__head .label { margin: 0; }
  .sv__head h2 { font-size: clamp(2rem, 1.25rem + 2.8vw, 3.4rem); }
  .sv__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: clamp(14px, 1.6vw, 22px); }
  .sv__card { display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: var(--r-panel); overflow: hidden; background: var(--ground-2); color: inherit; text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow 200ms var(--ease); }
  .sv__card:hover { box-shadow: inset 0 0 0 1.5px var(--paint); }
  .sv__img { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--ground); display: grid; place-items: center; }
  .sv__img :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sv__word { width: 100%; height: 100%; display: grid; place-items: end start; padding: 18px 20px; background: var(--slab); color: var(--bone);
    font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 1.3rem + 1.6vw, 2.6rem); letter-spacing: -0.03em; line-height: 0.95;
    background-image: repeating-linear-gradient(135deg, rgb(255 255 255 / 0.035) 0 2px, transparent 2px 14px); }
  .sv__body { display: grid; gap: 10px; align-content: start; padding: 18px 20px 20px; }
  .sv__name { font-family: var(--font-display); font-size: 1.22rem; letter-spacing: -0.015em; line-height: 1.15; }
  .sv__line { color: var(--ink-2); font-size: 0.98rem; line-height: 1.45; }
  .sv__go { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; font-weight: 650; font-size: 0.94rem; color: var(--ink); }
</style>
