---
/**
 * A drawn plan-sheet glyph for each guide — there is no honest photograph of a statute, a rebate form
 * or a water bill, so the guides use line drawings in the site's plan language instead: bone linework
 * on the wet-base slab, one paint mark per drawing (the thing the guide answers).
 *   rules  — a lot plan: property line, house, street; the backyard outlined in paint
 *   hoa    — the committee packet: a letter with a stamp
 *   rebate — a water drop with the rebate struck through
 *   water  — a rain gauge filled to the season's line
 *   cost   — a section through the ground: turf, base, subgrade, with a paint depth mark
 * A guide without a bespoke drawing gets its topic's (src/data/guide-topics.ts), same line language:
 *   pets           paw  — a paw over turf and base; paint: the water passing down through them
 *   weather        sky  — sun, a cloud dropping hail; paint: the turf surface that takes it
 *   installation   cut  — the excavation filled with base below the old grade; paint: compaction
 *   products       tuft — magnified tufts on their backing; paint: the pile-height dimension
 *   care-and-repair seam — two pieces meeting at a seam; paint: the stitch across it
 *   putting-greens flag — the green's contours, ball, roll line and cup; paint: the flag
 *   safety         fall — a swing set in elevation; paint: the fall zone under it
 *   comparisons    vs   — turf beside rock and planting; paint: the line between them
 *   buying         quote — a quote's line items and total; paint: the bracket that sums them
 *   rules-and-hoa  rules · water water (the launch drawings stand for their topics)
 *   commercial     site — a building, parking stalls, a walk; paint: the common area
 *   yard-design    yard — house, patio, a tree's shade; paint: the layout line of the turf edge
 */
interface Props { id?: string; topic?: string; class?: string; }
const { id = '', topic = '', class: cls } = Astro.props;
const BESPOKE: Record<string, string> = {
  'turf-rules-northern-colorado': 'rules', 'hoa-turf-approval': 'hoa', 'turf-rebates-northern-colorado': 'rebate',
  'water-savings': 'water', 'artificial-turf-cost': 'cost',
};
const BY_TOPIC: Record<string, string> = {
  pets: 'paw', weather: 'sky', installation: 'cut', products: 'tuft', 'care-and-repair': 'seam', 'putting-greens': 'flag',
  safety: 'fall', comparisons: 'vs', buying: 'quote', 'rules-and-hoa': 'rules', water: 'water', commercial: 'site', 'yard-design': 'yard',
};
const kind = BESPOKE[id] ?? BY_TOPIC[topic] ?? 'doc';
