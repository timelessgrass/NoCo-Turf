---
/**
 * TownStatute — state and county layer records under a town's own rule: citation (linked to its source),
 * when it took or takes effect, and the record's fact sentence as written. Used inside an evidence panel,
 * and for a town's own place and housing records ("On the public record"). An empty title prints none.
 */
import Icon from './Icon.astro';
import { cite, labelHead, fmtDate, type LayerRecord } from './TownData';
interface Props { records: LayerRecord[]; title?: string; asOf: string }
const { records, title = 'Colorado law underneath', asOf } = Astro.props;
---
{records.length > 0 && (
  <div class="tst">
    {title && <p class="label tst__title">{title}</p>}
    <ul class="tst__list" role="list">
      {records.map((r) => (
        <li>
          <a class="tst__cite" href={r.source_url} rel="noopener">
            <span class="tst__c">{cite(r) ?? labelHead(r.source_label)}</span>
            {r.effective && <span class="tst__eff">{r.effective > asOf ? 'from' : 'since'} {fmtDate(r.effective)}</span>}
            <Icon name="external" size={13} class="tst__ext" />
          </a>
          <p class="tst__fact">{r.fact}</p>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .tst__title { margin: 0 0 4px; }
  .tst__list { list-style: none; display: grid; }
  .tst__list li { padding: 2px 0 12px; border-top: 1px dashed rgb(var(--ink-rgb) / 0.22); }
  .tst__cite { display: flex; flex-wrap: wrap; gap: 2px 10px; align-items: center; min-height: 44px; text-decoration: none;
    font-family: var(--font-display); font-weight: 720; font-stretch: 100%; font-size: 0.88rem; }
  .tst__cite:hover .tst__c { text-decoration: underline; text-decoration-color: var(--paint); text-decoration-thickness: 2px; }
  .tst__c { overflow-wrap: anywhere; }
  .tst__eff { font-weight: 500; font-stretch: 90%; color: var(--ink-3); font-size: 0.78rem; }
  .tst__cite :global(.tst__ext) { color: var(--ink-3); }
  .tst__fact { margin: 0; font-size: 0.86rem; line-height: 1.5; color: var(--ink-2); }
</style>
