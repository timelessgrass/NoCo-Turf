---
/**
 * Section head for the service pages — the homepage's .shead grammar (label → H2 sentence → lede), kept
 * as a component so /services/ and /services/{slug}/ share one rhythm. `split` puts the lede beside the
 * H2 on desktop (.shead--split). The H2 comes in through the slot so a payoff can carry <PaintWord>.
 */
interface Props { label: string; id: string; lede?: string; split?: boolean; paint?: boolean; class?: string; }
const { label, id, lede, split = false, paint = false, class: cls } = Astro.props;
---
<header class:list={['svhead', { 'svhead--split': split }, cls]}>
  <div class="svhead__title">
    <p class:list={['label', { 'label--paint': paint }]}>{label}</p>
    <h2 id={id}><slot /></h2>
  </div>
  {lede && <p class="lede svhead__lede">{lede}</p>}
</header>

<style>
  .svhead { display: grid; gap: 16px; margin-bottom: clamp(32px, 4.4vw, 64px); }
  .svhead__title { display: grid; gap: 14px; }
  .svhead h2 { max-width: 16ch; }
  .svhead__lede { margin: 0; }
  .svhead--split { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); align-items: end; gap: 24px 64px; }
  @media (max-width: 899px) { .svhead--split { grid-template-columns: 1fr; } }
</style>
