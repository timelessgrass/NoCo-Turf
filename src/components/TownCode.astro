---
/**
 * TownCode — an ordinance as a code card: the section number, whether it is in force, drafted or coming,
 * and the rule quoted word for word from the layer record, with the source it was read from.
 */
import Icon from './Icon.astro';
import { cite, labelHead, codeStatus, type LayerRecord } from './TownData';
interface Props { records: LayerRecord[]; asOf: string }
const { records, asOf } = Astro.props;
---
<div class="tcode">
  {records.map((r) => {
    const c = cite(r);
    const st = codeStatus(r, asOf);
    return (
      <figure class="tcode__card">
        <figcaption class="tcode__top">
          <span class:list={['tcode__sec', { 'tcode__sec--word': !c }]}>{c ?? labelHead(r.source_label)}</span>
          <span class:list={['tcode__state', `is-${st.tone}`]}>{st.text}</span>
        </figcaption>
        {r.quote
          ? <blockquote class="tcode__q" cite={r.source_url}><p>{r.quote}</p></blockquote>
          : <p class="tcode__q tcode__q--fact">{r.fact}</p>}
        <p class="tcode__src"><a href={r.source_url} rel="noopener">{r.source_label}<Icon name="external" size={13} /></a></p>
      </figure>
    );
  })}
</div>

<style>
  .tcode { display: grid; gap: 14px; }
  .tcode__card { margin: 0; position: relative; padding: 18px 18px 16px 22px; border-radius: var(--r-control); background: var(--ground);
    box-shadow: inset 0 0 0 1px var(--line), 0 1px 0 rgb(var(--ink-rgb) / 0.04); }
  .tcode__card::before { content: ''; position: absolute; left: 0; top: 16px; bottom: 16px; width: 3px; border-radius: 0 3px 3px 0; background: var(--ink); }
  .tcode__top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 14px; margin-bottom: 12px; }
  .tcode__sec { overflow-wrap: anywhere; }
  .tcode__sec { font-family: var(--font-display); font-weight: 820; font-stretch: 112%; font-size: 1.32rem; letter-spacing: -0.02em; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .tcode__sec--word { font-size: 1.02rem; font-stretch: 100%; font-weight: 740; }
  .tcode__state { font-family: var(--font-display); font-weight: 650; font-stretch: 80%; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase;
    padding: 4px 8px; border-radius: var(--r-chip); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-2); white-space: nowrap; }
  .tcode__state.is-live { background: var(--ink); color: var(--bone); box-shadow: none; }
  .tcode__state.is-pending { box-shadow: inset 0 0 0 1.5px var(--paint); color: var(--ink); background: rgb(var(--paint-rgb) / 0.08); }
  .tcode__state.is-future { box-shadow: none; border: 1.5px dashed var(--ink-3); padding: 2.5px 6.5px; }
  .tcode__q { margin: 0; font-size: 0.96rem; line-height: 1.58; color: var(--ink); }
  .tcode__q p { margin: 0; }
  .tcode__q p::before { content: '“'; } .tcode__q p::after { content: '”'; }
  .tcode__q--fact { color: var(--ink-2); }
  .tcode__src { margin: 12px 0 0; font-size: 0.8rem; line-height: 1.4; }
  .tcode__src a { color: var(--ink-3); text-decoration: none; display: inline; padding-block: 13px; }
  .tcode__src a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--paint); }
  .tcode__src :global(svg) { display: inline-block; vertical-align: -1px; margin-left: 4px; }
</style>
