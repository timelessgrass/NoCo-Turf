---
/**
 * /work/ — every photograph in src/data/photos.ts on one contact sheet (WorkReel), the crew clip, and the
 * promise of what comes next: per-job write-ups (before → base → after, with the job card) as Brian's job
 * ledger arrives (src/content/work/*.json — none yet; no /work/{id}/ route exists, so none is linked).
 *
 * Sheet order is editorial and chosen so the WorkReel's frame shapes fit the photographs: frames 01–03 are one
 * putting green seen from three sides (proof.json job_group windsor-2025-08-20); the portrait originals land
 * in the tall frames. Any photo added to photos.ts later is appended automatically — nothing is ever left out.
 * The roll line (frames · places · dates) is computed from photos.ts, never typed.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CoHead from '../components/CoHead.astro';
import CoCrewClip from '../components/CoCrewClip.astro';
import WorkReel from '../components/WorkReel.astro';
import CtaBand from '../components/CtaBand.astro';
import PaintWord from '../components/PaintWord.astro';
import Icon from '../components/Icon.astro';
import { PHOTOS, photo } from '../data/photos';
import { phoneHref, phoneDisplay } from '../data/brief';

const ORDER = ['boulders', 'street-view', 'driveway', 'side-yard', 'fenced-yard', 'rock-border', 'fire-pit', 'crew', 'playset', 'dusk'];
const sheet = [...ORDER.filter((id) => PHOTOS.some((p) => p.id === id)).map(photo), ...PHOTOS.filter((p) => !ORDER.includes(p.id))];



const crumbs = [{ name: 'Work', path: '/work/' }];
---
<Base
  title="Our Work: Turf Jobs Across Northern Colorado | NoCo Turf Co."
  description="Putting greens, back lawns and side yards we've built near Berthoud, Windsor and Greeley. See the work, then book a yard walk for your own yard."
  crumbs={crumbs}
>
  <PageHero
    label="The work"
    crumbs={crumbs}
    lede="Putting greens, lawns and side yards we’ve built around Windsor, Berthoud and Greeley. Tap any photo to see it full size."
  >
    Real yards across <PaintWord now>Northern Colorado.</PaintWord>
    <div slot="after" class="wk-acts">
      <a class="btn btn--paint" href="#estimate" data-cta="work-hero-quote">Book a yard walk <Icon name="arrow" /></a>
      {phoneHref && <a class="btn btn--line" href={phoneHref} data-cta="work-hero-call"><Icon name="phone" />Call <span class="btn__num">{phoneDisplay}</span></a>}
    </div>
  </PageHero>

  <section class="section ground-2 wk-sheet" aria-labelledby="sheet-h">
    <div class="wrap">
      <CoHead label="Photos" id="sheet-h" split lede="When you compare installers, look closely at the edges, where turf meets concrete, rock and curb. That’s where careful work shows.">
        Lawns, greens and <PaintWord>the details.</PaintWord>
      </CoHead>
      <div class="wk-reel">
        <WorkReel photos={sheet} />
      </div>
    </div>
  </section>

  <section class="section on-slab wk-crew" aria-labelledby="crew-h">
    <div class="wrap wk-crew__grid">
      <div class="wk-crew__copy">
        <CoHead label="On the job" id="crew-h" paint>The finishing <PaintWord text>pass.</PaintWord></CoHead>
        <p>The last step on a new lawn: a power broom stands the blades up and settles the infill, so the turf looks like grass, not carpet.</p>
      </div>
      <CoCrewClip label="On the job" sizes="(max-width: 899px) 90vw, 32vw" />
    </div>
  </section>

  <CtaBand title="Like what you see?" payoff="Let’s walk your yard." />
</Base>

<style>
  /* ── Roll line: the edge print of a contact sheet ── */
  .wk-roll { position: relative; display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 0; margin: 30px 0 0; padding: 18px 4px;
    border-radius: var(--r-control); background: var(--slab); color: var(--bone); overflow: hidden; }
  .wk-roll::before, .wk-roll::after { content: ''; position: absolute; left: 0; right: 0; height: 6px;
    background: repeating-linear-gradient(90deg, transparent 0 8px, rgb(var(--bone-rgb) / 0.22) 8px 16px); }
  .wk-roll::before { top: 5px; } .wk-roll::after { bottom: 5px; }
  .wk-roll div { padding: 4px 22px; border-left: 1px solid var(--bone-line); }
  .wk-roll div:first-child { border-left: 0; }
  .wk-roll dt { font-family: var(--font-display); font-size: var(--fs-label); font-weight: 640; font-stretch: 76%; letter-spacing: 0.17em; text-transform: uppercase; color: var(--bone-3); }
  .wk-roll dd { margin: 4px 0 0; font-family: var(--font-display); font-weight: 760; font-stretch: 108%; font-size: 1.05rem; letter-spacing: -0.01em; }
  .wk-roll dd.num { font-size: 1.6rem; font-weight: 820; line-height: 1; color: var(--paint); }

  /* ── The sheet. WorkReel's 9-frame rhythm, finished for ten, and a real grid on phones (this page is
        the photos — a sideways strip would hide nine of them). ── */
  @media (min-width: 900px) {
    .wk-reel :global(.reel__item:nth-child(9)), .wk-reel :global(.reel__item:nth-child(10)) { grid-column: span 6; grid-row: auto; }
    .wk-reel :global(.reel__item:nth-child(9) .reel__frame), .wk-reel :global(.reel__item:nth-child(10) .reel__frame) { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 899px) {
    .wk-reel :global(.reel__grid) { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 12px;
      overflow: visible; scroll-snap-type: none; padding-inline: 0; margin-inline: 0; }
    .wk-reel :global(.reel__item .reel__frame) { aspect-ratio: 4 / 5; }
    .wk-reel :global(.reel__item:nth-child(3n + 1)) { grid-column: 1 / -1; }
    .wk-reel :global(.reel__item:nth-child(3n + 1) .reel__frame) { aspect-ratio: 4 / 3; }
    .wk-reel :global(.reel__count) { display: none; }
    .wk-reel :global(figcaption) { font-size: 0.86rem; column-gap: 8px; }
  }

  /* ── Crew ── */
  .wk-crew__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr); gap: clamp(32px, 6vw, 110px); align-items: center; }
  .wk-crew__grid :global(.co-clip) { max-width: 420px; justify-self: end; width: 100%; }
  .wk-crew__copy :global(.co-head) { margin-bottom: 26px; }
  .wk-crew__copy > p { color: var(--bone-2); max-width: 50ch; }

  @media (max-width: 899px) {
    .wk-crew__grid { grid-template-columns: 1fr; }
    .wk-crew__grid :global(.co-clip) { justify-self: start; max-width: 360px; }
    .wk-roll { grid-template-columns: repeat(2, auto); row-gap: 12px; }
    .wk-roll div:nth-child(3) { border-left: 0; }
    .wk-roll__wide { grid-column: 1 / -1; border-left: 0 !important; }
  }
  .wk-acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
</style>
