---
/**
 * /review/ — replaces the old site's GoHighLevel "5 Star Review Funnel", which sent 4–5★ answers to
 * Google and 1–3★ to a private form. That is review gating: Google's policy forbids selectively
 * soliciting positive reviews, and the FTC rule (16 CFR 465.7) forbids showing a filtered set.
 *
 * This page offers the SAME link to everyone: no star question first, no branch that intercepts
 * unhappy customers, no incentive, no request for particular content, no employee names.
 * A private feedback line is offered to everyone equally, beside — never instead of — Google.
 * Never indexed (it is a destination for customers, not a search page).
 *
 * The link renders only when the brief carries the GBP place ID as a renderable fact
 * (identity.gbp_place_id). Custom g.page/<name>/review short links are deprecated — use writereview.
 */
import Base from '../layouts/Base.astro';
import brief, { fact, businessName, phoneHref, phoneDisplay } from '../data/brief';
const placeId = fact<string>(brief.identity?.gbp_place_id);
const reviewUrl = placeId ? `https://search.google.com/local/writereview?placeid=${encodeURIComponent(placeId)}` : null;
---
<Base title={`Leave a review | ${businessName ?? 'NoCo Turf Co.'}`} description="Tell others how your turf project went." noindex>
  <h1>How did your project go?</h1>
  {reviewUrl
    ? <p><a href={reviewUrl} rel="noopener" data-cta="review-google">Leave a review on Google</a></p>
    : <Fragment set:html="<!-- review link not rendered: identity.gbp_place_id is not a renderable fact in .site/truth/brief.json -->" />}
  {phoneHref && <p>Questions about your turf, or anything that needs attention? Call or text <a href={phoneHref} data-cta="review-call">{phoneDisplay}</a>.</p>}
</Base>
