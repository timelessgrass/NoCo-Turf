---
/**
 * /services/ — the index of the five previewable services, drawn as a site plan (ServicePlan) rather than
 * a card grid: one lot with the four home jobs laid out on it, an HOA common area across the street, and
 * a legend that is the real list of links. Then the guides every service page leans on, then the close.
 * PREVIEW: every service is unconfirmed (services.ts), so the page carries the Draft ribbon.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PaintWord from '../../components/PaintWord.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceHead from '../../components/ServiceHead.astro';
import ServicePlan from '../../components/ServicePlan.astro';
import { visibleServices } from '../../data/services';
import { SITE } from '../../data/site';
import { isPublished } from '../../lib/content-policy.mjs';
import { visibleGuides, guideLabel } from '../../lib/visible';
import { phoneHref, phoneDisplay } from '../../data/brief';
import { LIVE_LAYER_IDS } from '../../lib/layers';

const entries = await getCollection('services');
const liveIds = LIVE_LAYER_IDS;

const items = visibleServices.map((s) => {
  const d = entries.find((e) => e.data.slug === s.slug)?.data;
  return {
    slug: s.slug, name: s.name, short: s.short, underneath: s.underneath,
    photos: d?.photos.length ?? 0,
    rules: new Set((d?.layerRefs ?? []).filter((id) => liveIds.has(id))).size,
    questions: d?.faq.length ?? 0,
  };
});
/* "Read first": the rules, rebates and cost guides every service page leans on — at most six, however many
   guides the site grows to (the rest are a click away on /guides/). */
const READ_FIRST = ['rules-and-hoa', 'water', 'buying'];
const guides = (await visibleGuides()).filter((g) => READ_FIRST.includes(g.topic.slug)).slice(0, 6);
const draft = visibleServices.some((s) => !s.confirmed) || entries.some((e) => !isPublished(e.data));
const crumbs = [{ name: 'Services', path: '/services/' }];
const graph = [{
  '@type': 'ItemList', '@id': `${SITE}/services/#list`, name: 'Services',
  itemListElement: visibleServices.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: `${SITE}/services/${s.slug}/` })),
}];
---
<Base
  title="Artificial Turf Services in Northern Colorado | NoCo Turf Co."
  description="Artificial turf lawns, dog runs, putting greens, play areas and HOA or sports turf across Northern Colorado, each explained by what decides whether it lasts."
  crumbs={crumbs}
  graph={graph}
  draft={draft}
>
  <PageHero label="Services · Northern Colorado" crumbs={crumbs}
    lede="Five kinds of turf job from Wellington to Longmont, Loveland to Eaton. Each page says what the job involves, what decides whether it lasts, and which Colorado and town rules touch it, with the source for every rule.">
    A dog run isn't a putting green. <PaintWord now>The base knows the difference.</PaintWord>
    <div slot="after" class="svx__cta">
      <a class="btn btn--paint" href="#estimate" data-cta="services-hero-quote">Ask about your yard <Icon name="arrow" /></a>
      {phoneHref && <a class="btn btn--line" href={phoneHref} data-cta="services-hero-call"><Icon name="phone" />Call <span class="btn__num">{phoneDisplay}</span></a>}
    </div>
  </PageHero>

  <!-- The index — "Do you do the specific thing I need?" -->
  <section class="section svx" aria-labelledby="svx-h">
    <div class="wrap">
      <ServiceHead label="What we install" id="svx-h" split
        lede="Find the job on the plan, then open its page. The paint line on each one is the layout: where the turf goes, and the edge it has to hold.">
        Five jobs on one plan.
      </ServiceHead>
      <ServicePlan items={items} />
    </div>
  </section>

  <!-- Read first — "Where do the rules come from?" -->
  {guides.length > 0 && (
    <section class="section section--tight ground-2 svx-read" aria-labelledby="svx-read-h">
      <div class="wrap svx-read__grid">
        <ServiceHead label="Read first" id="svx-read-h" lede="Every service page leans on these. Each one keeps its sources and the date they were checked.">
          The rules, rebates and costs, in depth.
        </ServiceHead>
        <ul class="svx-read__list" role="list">
          {guides.map((g) => {
            const d = g.entry.data as { title: string; description: string };
            return (
              <li>
                <a class="svx-read__row" href={`/guides/${g.id}/`}>
                  <span class="svx-read__name">{guideLabel(d.title)}</span>
                  <span class="svx-read__desc">{d.description}</span>
                  <span class="svx-read__go" aria-hidden="true"><Icon name="arrow" size={18} /></span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- Close — "Fine — what happens if I ask?" -->
  <CtaBand title="Start with the yard" payoff="you have."
    lede="Not sure which of the five it is? Pick “Not sure yet” in the form. Three short parts, no account, no upload." />
</Base>

<style>
  .svx__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .svx-read__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 32px 80px; align-items: start; }
  .svx-read__grid :global(.svhead h2) { font-size: clamp(1.9rem, 1.2rem + 2.4vw, 3.2rem); }
  .svx-read__list { list-style: none; border-top: 2px solid var(--ink); }
  .svx-read__row { display: grid; grid-template-columns: minmax(0, 1fr) 44px; gap: 4px 20px; align-items: center; padding: 18px 0; border-bottom: 1px dashed rgb(var(--ink-rgb) / 0.28); text-decoration: none; }
  .svx-read__name { font-family: var(--font-display); font-weight: 760; font-stretch: 110%; font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem); letter-spacing: -0.02em; line-height: 1.15; }
  .svx-read__desc { grid-column: 1; color: var(--ink-3); font-size: var(--fs-small); max-width: 64ch; }
  .svx-read__go { grid-column: 2; grid-row: 1 / span 2; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1.5px var(--line);
    transition: background-color var(--t2) var(--ease), box-shadow var(--t2) var(--ease); }
  .svx-read__row:hover .svx-read__go, .svx-read__row:focus-visible .svx-read__go { background: var(--paint); box-shadow: none; }
  .svx-read__row:hover .svx-read__name { text-decoration: underline; text-decoration-color: var(--paint); text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  @media (max-width: 899px) { .svx-read__grid { grid-template-columns: 1fr; } }
</style>
