---
/**
 * /services/{slug}/ — one page per visible service (src/data/services.ts visibleServices), its copy from
 * src/content/services/{slug}.md. PREVIEW BUILD: every service is unconfirmed, so every page carries the
 * Draft ribbon; at launch a page exists only when its service is confirmed AND its record is published.
 *
 * Spine, each beat named by the buyer question it answers:
 *   hero        "Do you do this?"             PageHero — a real job photo, or a drawn detail (ServiceGlyph)
 *   answer      "Give me the short version."  AnswerBox + what decides it (+ Brian's own words, if any)
 *   photos      "Show me."                    ServiceGallery — only honest photos of this kind of job
 *   details     "What does the job involve?"  the Markdown body, a sticky contents list whose rail fills
 *                                             as you read, then every layer record the copy leans on
 *   the build   (lawn only)                   BuildSection
 *   where       "Do you come to my town?"     ServiceWhere — chips that paint routes on the corridor map
 *   by town     "What's different in my town?" ServiceByTown — this service's town × service pages
 *                                             (/areas/{town}-co/{service}/) by region; absent until one exists
 *   questions   "The things I'll ask."        Faq, mirrored verbatim into FAQPage JSON-LD
 *   read next   "Where can I check this?"     related guides + Sources
 *   close       "Fine — what now?"            CtaBand with the form, this service preselected
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PaintWord from '../../components/PaintWord.astro';
import Icon from '../../components/Icon.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import BuildSection from '../../components/BuildSection.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import ServiceHead from '../../components/ServiceHead.astro';
import ServiceGlyph from '../../components/ServiceGlyph.astro';
import ServiceGallery from '../../components/ServiceGallery.astro';
import ServiceWhere from '../../components/ServiceWhere.astro';
import ServiceRules from '../../components/ServiceRules.astro';
import ServiceRelated from '../../components/ServiceRelated.astro';
import ServiceByTown from '../../components/ServiceByTown.astro';
import Reviews from '../../components/Reviews.astro';
import { PICKS } from '../../data/reviews';
import SellTrust from '../../components/SellTrust.astro';
import SellSteps from '../../components/SellSteps.astro';
import SellDecide from '../../components/SellDecide.astro';
import RulesDrawer from '../../components/RulesDrawer.astro';
import { SERVICE_SELL } from '../../data/service-sell';
import { visibleServices, type Service } from '../../data/services';
import { SHOW_DRAFTS } from '../../data/site';
import { isPublished } from '../../lib/content-policy.mjs';
import { photo as photoById } from '../../data/photos';
import { scene, SERVICE_SCENE } from '../../data/scenes';
import { visibleTowns, visibleTownServices } from '../../lib/visible';
import { townServiceBySlug } from '../../data/town-services.mjs';
import { faqGraph, serviceGraph } from '../../lib/schema';
import brief, { facts, phoneHref, phoneDisplay } from '../../data/brief';

export async function getStaticPaths() {
  const entries = await getCollection('services');
  return visibleServices.flatMap((service) => {
    const entry = entries.find((e) => e.data.slug === service.slug);
    if (!entry) throw new Error(`/services/${service.slug}/: no record in src/content/services/ — write ${service.slug}.md`);
    if (!SHOW_DRAFTS && !isPublished(entry.data)) return [];
    return [{ params: { slug: service.slug }, props: { service, entry } }];
  });
}

type Props = { service: Service; entry: CollectionEntry<'services'> };
const { service, entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
const path = `/services/${service.slug}/`;
const crumbs = [{ name: 'Services', path: '/services/' }, { name: service.name, path }];

/* Words that belong to the page, not the record: labels, CTA verbs and section heads. Each CTA verb differs
   from the site-wide "Book a yard walk" and from every other touchpoint on the page. */
type UI = { label: string; cta: string; gallery?: { label: string; title: string; lede: string }; where: { title: string; lede: string };
  faq: { title: string; lede: string }; read: string; band: { title: string; payoff: string; lede: string } };
const lede3 = 'Five quick questions, then we’ll reach out to set a time.';
const UIS: Record<string, UI> = {
  'artificial-turf-installation': {
    label: 'Artificial turf · Lawn replacement',
    cta: 'Ask about your lawn',
    gallery: { label: 'Recent work', title: 'Turf lawns we’ve built.', lede: 'Look closely at where the turf meets rock, concrete and curb. That’s where careful work shows.' },
    where: { title: 'Turf lawns from Wellington to Longmont.', lede: 'Each town has its own turf rules. Pick yours to see what’s allowed.' },
    faq: { title: 'Questions homeowners ask about turf lawns.', lede: 'Short answers to what we hear most.' },
    read: 'Rules, rebates, water and cost, in depth.',
    band: { title: 'Start with the ground', payoff: 'under your lawn.', lede: `Tell us about the yard, the town and how to reach you. ${lede3}` },
  },
  'pet-turf': {
    label: 'Pet turf · Dog runs',
    cta: 'Ask about your dog run',
    where: { title: 'Dog runs from Wellington to Longmont.', lede: 'Each town has its own turf rules. Pick yours to see what’s allowed.' },
    faq: { title: 'Questions dog owners ask.', lede: 'Smell, heat, digging and the HOA.' },
    read: 'Before the dogs get their yard.',
    band: { title: 'Tell us about the dogs', payoff: 'and the yard.', lede: `How many, how big, and where they run now. ${lede3}` },
  },
  'putting-greens': {
    label: 'Putting greens · Backyard golf',
    cta: 'Ask about a green',
    gallery: { label: 'Recent work', title: 'Backyard greens we’ve built.', lede: 'A few of the backyard greens we’ve built. Look at the fringe where it meets rock and concrete.' },
    where: { title: 'Backyard greens from Wellington to Longmont.', lede: 'Each town has its own turf rules. Pick yours to see what’s allowed.' },
    faq: { title: 'Questions about backyard greens.', lede: 'Roll, speed, break and winter, and whether an HOA can say no.' },
    read: 'The rules and the numbers behind a green.',
    band: { title: 'Pick the spot', payoff: 'for the green.', lede: `Tell us about the yard and who’ll be putting on it. ${lede3}` },
  },
  'playground-turf': {
    label: 'Playground turf · Fall zones',
    cta: 'Ask about your play area',
    where: { title: 'Play areas from Wellington to Longmont.', lede: 'Each town has its own turf rules. Pick yours to see what’s allowed.' },
    faq: { title: 'Questions about playground turf.', lede: 'Falls, heat, HOAs and daycares.' },
    read: 'The rules behind play turf.',
    band: { title: 'Show us the playset', payoff: 'and what’s under it.', lede: `Tell us how tall the set is and where it sits. ${lede3}` },
  },
  'commercial-turf': {
    label: 'Common areas · Functional turf',
    cta: 'Ask about a bid',
    where: { title: 'Common areas from Wellington to Longmont.', lede: 'Each town page covers that town’s own turf rules, so a board can check them before it votes.' },
    faq: { title: 'Questions boards and managers ask.', lede: 'What Colorado law and your town allow, in plain terms.' },
    read: 'The law and the money, in depth.',
    band: { title: 'Tell us the site', payoff: 'and what it’s for.', lede: `The property, the town and what the turf is for. ${lede3}` },
  },
};
const ui: UI = UIS[service.slug] ?? {
  label: service.name, cta: 'Ask about your yard',
  where: { title: 'Wellington to Longmont.', lede: 'Each town page covers its own turf rules, water provider and ground.' },
  faq: { title: 'What people ask first.', lede: 'Short answers to what we hear most.' },
  read: 'Go deeper before you decide.', band: { title: 'Tell us about', payoff: 'the yard.', lede: lede3 },
};

/* H1: a claim in two sentences — the second is the payoff and gets the painted line (copy.md form A). */
const split = data.h1.match(/^(.+?[.?!])\s+(\S.*)$/);
const [claim, payoff] = split ? [split[1], split[2]] : [data.h1, ''];

/* Photos: the hero is the service's own photo (services.ts), else the record's first; the strip gets the rest. */
const heroId = service.photo ?? data.photos[0] ?? null;
const heroScene = !heroId && SERVICE_SCENE[service.slug] ? scene(SERVICE_SCENE[service.slug] === 'dog-run' ? 'dogs-playing' : SERVICE_SCENE[service.slug]) : null;
const heroPhoto = heroId ? photoById(heroId) : heroScene;
const gallery = data.photos.filter((p) => p !== heroId).map(photoById);
const og = heroPhoto ? (await getImage({ src: heroPhoto.src, width: 1200, format: 'jpg', quality: 76 })).src : undefined;

const towns = await visibleTowns();
/* This service's town × service pages in this build (putting greens, pet, play and commercial only). */
const byTown = townServiceBySlug[service.slug] ? (await visibleTownServices()).filter((p) => p.service.slug === service.slug) : [];
const areas = facts<string>(((brief.service_areas ?? []) as any[]).map((a) => a?.name));
const graph = [...serviceGraph(service.name, path, data.description, areas), ...faqGraph(data.faq)];
const draft = !service.confirmed || !isPublished(data);
const sell = SERVICE_SELL[service.slug];
---
<Base title={data.title} description={data.description} crumbs={crumbs} graph={graph} draft={draft} ogImage={og}>
  <div class:list={['svhero', { 'svhero--glyph': !heroPhoto }]}>
    <PageHero label={ui.label} crumbs={crumbs} photo={heroPhoto} caption={!heroScene} lede={sell?.lede ?? data.lede}>
      {sell ? <>{sell.h1.slice(0, sell.h1.indexOf(sell.paint))}<PaintWord now>{sell.paint}</PaintWord></> : <>{claim}{payoff && <> <PaintWord now>{payoff}</PaintWord></>}</>}
      <Fragment slot="after">
        <div class="svhero__cta">
          <a class="btn btn--paint" href="#estimate" data-cta="svc-hero-quote">Book a yard walk <Icon name="arrow" /></a>
          {phoneHref && <a class="btn btn--line" href={phoneHref} data-cta="svc-hero-call"><Icon name="phone" />Call <span class="btn__num">{phoneDisplay}</span></a>}
        </div>
        {!heroPhoto && <ServiceGlyph slug={service.slug} class="svhero__glyph" />}
      </Fragment>
    </PageHero>
  </div>

  <SellTrust />

  <section class="svintro" aria-label="Short answer">
    <div class="wrap svintro__grid">
      <AnswerBox question={data.answer.question} answer={data.answer.answer} />
      <aside class="svnote" aria-label="What you get">
        <p class="svnote__line">{service.underneath}</p>
      </aside>
    </div>
  </section>

  {sell && <SellDecide s={sell} name={service.name} />}

  {gallery.length >= 2 && ui.gallery && (
    <ServiceGallery photos={gallery} label="Recent work" title={ui.gallery.title} lede={ui.gallery.lede} />
  )}

  <Reviews pick={PICKS[service.slug]} tone="ground-2" />

  {service.slug === 'artificial-turf-installation' && <BuildSection />}

  <SellSteps />

  {byTown.length > 0
    ? <ServiceByTown service={townServiceBySlug[service.slug]?.crumb ?? service.name} pages={byTown} />
    : <ServiceWhere towns={towns} title={ui.where.title} lede={ui.where.lede} />}

  {data.faq.length > 0 && (
    <section class="section ground-2 svfaq" id="faq" aria-labelledby="faq-h">
      <div class="wrap svfaq__grid">
        <ServiceHead label="Questions" id="faq-h">{ui.faq.title}</ServiceHead>
        <Faq items={data.faq} name={`faq-${service.slug}`} />
      </div>
    </section>
  )}

  <RulesDrawer title={`More about ${service.name.charAt(0).toLowerCase() + service.name.slice(1)}, with the rules and sources`} label="Go deeper">
    <div class="wrap svdeep">
      <article class="prose svprose">
        <Content />
        <ServiceRules ids={data.layerRefs} />
      </article>
    </div>
    <ServiceRelated guides={data.guides} sources={data.sources} title={ui.read} />
  </RulesDrawer>

  <CtaBand title="Let’s talk about" payoff="your yard." lede={ui.band.lede} use={service.formUse} />
</Base>

<style>
  /* ── Hero ── */
  .svhero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .svhero :global(.svhero__glyph) { margin-top: clamp(32px, 5vw, 48px); }
  @media (min-width: 1100px) {
    .svhero--glyph :global(.ph__copy) { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); grid-template-rows: repeat(5, auto) 1fr; column-gap: clamp(40px, 5vw, 88px); }
    .svhero--glyph :global(.ph__copy > *) { grid-column: 1; }
    .svhero--glyph :global(.svhero__glyph) { grid-column: 2; grid-row: 1 / -1; align-self: end; margin-top: 0; }
  }

  /* ── Answer strip ── */
  .svintro { padding-block: clamp(32px, 4vw, 64px) 0; }
  .svintro__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.9fr); gap: clamp(20px, 3vw, 40px); align-items: stretch; }
  .svnote { display: grid; align-content: start; gap: 10px; padding: clamp(22px, 3vw, 34px); border-radius: var(--r-panel); box-shadow: inset 0 0 0 1.5px var(--line); }
  .svnote .label { margin: 0; }
  .svnote__line { margin: 0; font-family: var(--font-display); font-weight: 720; font-stretch: 106%; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); letter-spacing: -0.015em; line-height: 1.25; }
  @media (max-width: 899px) { .svintro__grid { grid-template-columns: 1fr; } }

  /* ── The full write-up, inside the drawer ── */

  .svprose :global(h2) { position: relative; padding-top: 22px; scroll-margin-top: calc(var(--header-h) + 20px); view-timeline: --svh block; }
  .svprose :global(h2)::before { content: ''; position: absolute; left: 0; top: 0; width: 56px; height: 4px; border-radius: 2px; transform-origin: left;
    background: repeating-linear-gradient(90deg, var(--paint) 0 14px, transparent 14px 21px); }
  .svprose > :global(h2:first-child) { margin-top: 0; }
  .svprose > :global(ol) { list-style: none; padding-left: 0; counter-reset: step; }
  .svprose > :global(ol > li) { counter-increment: step; position: relative; padding: 0 0 0 2.8em; margin: 0 0 0.9em; }
  .svprose > :global(ol > li)::before { content: counter(step, decimal-leading-zero); position: absolute; left: 0; top: 0.08em;
    font-family: var(--font-display); font-weight: 800; font-stretch: 110%; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .svprose > :global(ol > li)::after { content: ''; position: absolute; left: 0; top: 1.62em; width: 1.6em; height: 3px; border-radius: 2px; background: var(--paint); }
  .svprose > :global(ul > li)::marker { color: var(--paint); }
  .svprose :global(table) { margin-top: 1.2em; }
  .svprose :global(td:first-child) { font-family: var(--font-display); font-weight: 700; font-stretch: 104%; white-space: nowrap; padding-right: 20px; color: var(--ink); }
  .svprose :global(a) { text-decoration-color: var(--paint); }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      @keyframes svread-mark { from { scale: 0 1; } to { scale: 1 1; } }
      .svprose :global(h2)::before { animation: svread-mark linear both; animation-timeline: --svh; animation-range: entry 40% cover 30%; }
    }
  }

  /* ── FAQ ── */
  .svfaq__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 40px 80px; align-items: start; }
  .svfaq__grid :global(.svhead) { position: sticky; top: calc(var(--header-h) + 32px); }
  .svfaq__grid :global(.svhead h2) { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); }
  @media (max-width: 899px) { .svfaq__grid { grid-template-columns: 1fr; } .svfaq__grid :global(.svhead) { position: static; } }
  .svdeep { padding-block: clamp(24px, 3vw, 40px) 0; }
  .svdeep .svprose { max-width: 760px; }
</style>

<script>
  /* Contents: mark the section being read. The fill of the rail is CSS (scroll-driven), not this. */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const targets = links.map((a) => document.getElementById(a.dataset.toc!)).filter((t): t is HTMLElement => Boolean(t));
  if (targets.length) {
    let raf = 0;
    const sync = () => {
      raf = 0;
      const line = innerHeight * 0.32;
      let on = -1;
      targets.forEach((t, i) => { if (t.getBoundingClientRect().top <= line) on = i; });
      links.forEach((a, i) => (i === on ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    };
    addEventListener('scroll', () => { raf ||= requestAnimationFrame(sync); }, { passive: true });
    sync();
  }
</script>
