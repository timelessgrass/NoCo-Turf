---
/**
 * /areas/{town}-co/{segment}/ — the one route for the pages one level under a town page, which share that segment:
 *   a town × service page — /areas/{town}-co/{service}/, from visibleTownServices()
 *     (src/content/town-services/{town}--{service}.json; services: src/data/town-services.mjs)
 *   a community page      — /areas/{town}-co/{community}/, from visibleCommunities()
 *     (src/content/communities/{town}--{community}.json; src/data/communities.mjs)
 * getStaticPaths builds both lists and stops the build if two records claim one path (assertAreaChildren); a
 * community slug may never be a service slug or a reserved word in the first place (the schema, check-content and
 * the collection readers refuse one). Artificial turf installation × town is the town page itself (/areas/{town}-co/),
 * so it has no page here. The file keeps its name, [service].astro: Astro derives a page's scoped-style hash and its
 * stylesheet's name from the route's file name, so renaming it would change every town × service page's HTML.
 *
 * A TOWN × SERVICE PAGE — its own page, built from the town page's parts and the service page's voice but neither
 * one's shape. The record supplies every sentence of substance; the template only arranges it and adds what the
 * layer records and services.ts already say:
 *   top        crumbs, "{Service} · {Town}", the H1 (display.paint gets the painted mark), the lede, the two
 *              asks; the short answer under them; the job sheet beside both (on a phone, after the answer). On a
 *              putting-green page, one line under the answer links the town's golf communities that have pages
 *   blocks     the record's blocks in its order, numbered, each with its evidence (TownBlock). The Colorado
 *              backyard-HOA rule renders once (TownStateRule) after the first block that leans on it — never
 *              paraphrased in a block (docs/CONTRACTS.md "Shared-claim components")
 *   code       the town's code for this use, where a layer applies: its ordinance records and the state rule
 *              for this use that no block has already shown (TownServiceCode)
 *   photo      the record's photo with its caption and its real place (TownServicePhoto)
 *   strip      "What goes into {a putting green}" from services.ts, into /services/{service}/
 *   around     this service one town over (the town record's `nearby`, visible pages only) and the rest of
 *              the work in this town, the town page first
 *   read       the service's guide topic, when its hub is visible
 *   faq, sources, then the closing band with the ONE form, the town and the service's use preselected
 * JSON-LD: a Service in a City, provided by #business; BreadcrumbList Areas › {Town} › {Service} (Base, from
 * the crumbs); FAQPage mirroring the printed FAQ.
 *
 * A COMMUNITY PAGE — consistent with the town × service page (the same top, blocks, evidence, photo, around, FAQ
 * and sources), but its own page:
 *   top        crumbs Areas › {Town} › {Community}, "{Community} · {Town}", the H1 with its painted phrase, the lede,
 *              the asks; the short answer; the job sheet with the community as its first coordinate
 *   facts      the facts strip (CommunityFacts): the kind of place, who reviews a yard there (linked to its
 *              guidelines), the course it is built around (only while its cited record renders), the town
 *   blocks     numbered, with evidence; "Only in {Community}" marks the facts true of this community alone. The
 *              state HOA rule renders once, after the first block that leans on it — or, when none does and a
 *              body reviews yards there, right after the design review
 *   review     the design-review path (CommunityReview): what `governing.layerRefs` quote from the guidelines on
 *              turf, greens and the backyard, linked to /guides/hoa-turf-approval/
 *   photo      the record's photo, if any, with its real place and month
 *   around     "Around {Community}": the town page, the town's putting-green and pet-turf pages when visible, and
 *              the other visible communities in the town
 *   read       putting-green-design-ideas, outdoor-living-with-artificial-turf and the putting-greens hub, each only
 *              while visible
 *   faq, sources, the closing band with the ONE form, the town preselected
 * Its own rules (facts strip, review path) are in src/styles/community.css, linked by community pages alone: a
 * scoped <style> anywhere in this route's graph would change the stylesheet the town × service pages link.
 * JSON-LD: WebPage about → a Place (the community, inside its City, inside Colorado); a Service with that Place as
 * areaServed, provided by #business; BreadcrumbList Areas › {Town} › {Community}; FAQPage mirroring the printed FAQ.
 */
import { getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SellTrust from '../../../components/SellTrust.astro';
import SellGood from '../../../components/SellGood.astro';
import SellSteps from '../../../components/SellSteps.astro';
import SellServices from '../../../components/SellServices.astro';
import RulesDrawer from '../../../components/RulesDrawer.astro';
import { TOWN_SELL, HOA_LINE } from '../../../data/town-sell';
import { COMMUNITY_SELL } from '../../../data/community-sell';
import Faq from '../../../components/Faq.astro';
import Sources from '../../../components/Sources.astro';
import CtaBand from '../../../components/CtaBand.astro';
import PaintWord from '../../../components/PaintWord.astro';
import Icon from '../../../components/Icon.astro';
import TownBlock from '../../../components/TownBlock.astro';
import TownStateRule from '../../../components/TownStateRule.astro';
import TownServiceCard from '../../../components/TownServiceCard.astro';
import TownServiceCode from '../../../components/TownServiceCode.astro';
import TownServicePhoto from '../../../components/TownServicePhoto.astro';
import TownServiceAround from '../../../components/TownServiceAround.astro';
import TownServiceGuides from '../../../components/TownServiceGuides.astro';
import CommunityFacts from '../../../components/CommunityFacts.astro';
import CommunityReview from '../../../components/CommunityReview.astro';
import { visibleTownServices, visibleCommunities } from '../../../lib/visible';
import { assertAreaChildren } from '../../../lib/content-policy.mjs';
import { faqGraph, townServiceGraph, communityGraph } from '../../../lib/schema';
import { photo as photoById } from '../../../data/photos';
import { scene } from '../../../data/scenes';
import { phoneHref, phoneDisplay } from '../../../data/brief';
import {
  rec, recs, recordsFor, fmtDate, fmtMonth, miles, compass, countyLine, HOA_FAMILY, HOA_EXTRA, KIND_LABEL, type LayerRecord,
} from '../../../components/TownData';
import { COMMUNITY_GUIDES, COMMUNITY_TOPIC, COMMUNITY_SERVICES, KIND_NAMES } from '../../../data/communities.mjs';
/* Last on purpose: a `?url` import emits the file without adding it to this route's CSS, and placed here it leaves the
   order of the stylesheets every town × service page links exactly as it was. */
import communityCss from '../../../styles/community.css?url';

export async function getStaticPaths() {
  const pages = await visibleTownServices();
  const communities = await visibleCommunities();
  /* One path, one page: a community that would take a service's path (or another community's) stops the build. */
  assertAreaChildren([
    ...pages.map((p) => ({ path: p.path, what: `src/content/town-services/${p.id}.json` })),
    ...communities.map((c) => ({ path: c.path, what: `src/content/communities/${c.id}.json` })),
  ]);
  return [
    ...pages.map((p) => ({ params: { slug: p.town.slug, service: p.service.slug }, props: { kind: 'service' as const, id: p.id } })),
    ...communities.map((c) => ({ params: { slug: c.town.slug, service: c.slug }, props: { kind: 'community' as const, id: c.id } })),
  ];
}

const { kind, id } = Astro.props as { kind: 'service' | 'community'; id: string };
const pages = await visibleTownServices();
const communities = await visibleCommunities();

type Block = { kind: string; own: boolean; kicker: string; h2: string; takeaway?: string; paras: string[]; layerRefs: string[]; sources: string[] };
const leansOnHoa = (b: Block) => b.kind === 'hoa' || b.layerRefs.some((r) => HOA_FAMILY.has(r));

/* ───────────── A town × service page ───────────── */
async function townServicePage() {
  const page = pages.find((p) => p.id === id)!;
  const { town, service, meta } = page;
  const d = page.entry.data as any;
  const townData = town.entry.data as any;
  const name: string = town.name;
  const asOf: string = d.checked;
  const path = page.path;

  const blocks = d.blocks as Block[];

  /* The Colorado backyard-HOA rule: once, after the first block that leans on it — and only if one does. */
  const hoaAt = blocks.findIndex(leansOnHoa);
  const extra = HOA_EXTRA.filter((r) => blocks.some((b) => b.layerRefs.includes(r)));

  /* The code for this use: the town's turf ordinance records from the shared city-codes layer, and the state
     records that decide this use in new development — less anything a block's evidence panel already shows.
     Local records stay out: an uncited local ordinance is about another use (a dog limit, a fence height), so it
     would print under this page's turf-code heading. A record filed under this town for a folded-in place
     (Platteville on Greeley) is that place's rule, not the town's. */
  const cited = new Set(blocks.flatMap((b) => b.layerRefs));
  const folded: string[] = town.sections ?? [];
  const codeRecs = recordsFor(town.slug)
    .filter((r) => r.layer === 'ordinance' && !cited.has(r.id) && !folded.some((f) => r.source_label.startsWith(f)));
  const lawRecs = recs(meta.stateRefs).filter((r: LayerRecord) => !cited.has(r.id));

  /* The photo: the record's own, from photos.ts. */
  const photo = d.photo ? photoById(d.photo) : null;
  const og = photo ? (await getImage({ src: photo.src, width: 1200, format: 'jpg', quality: 72 })).src : undefined;

  /* The job sheet: each block by its kind and kicker, then the code and the photo when they're drawn. */
  const numbered = blocks.map((b, i) => ({ b, no: i + 1, id: `${b.kind}-${i + 1}` }));
  const rows = [
    ...numbered.map(({ b, id: bid }) => ({ label: KIND_LABEL[b.kind] ?? b.kind, value: b.kicker, href: `#${bid}`, own: b.own })),
    ...(codeRecs.length || lawRecs.length ? [{ label: 'Code', value: codeRecs.length ? `${name}’s turf code, quoted` : 'The Colorado rule', href: '#code', own: false }] : []),
    ...(photo ? [{ label: 'Photo', value: photo.caption, href: '#photo', own: false }] : []),
  ];

  /* Around: this service one town over, and the rest of the work in this town. */
  const nearby = (townData.nearby as string[])
    .map((s) => pages.find((p) => p.town.slug === s && p.service.slug === service.slug))
    .filter((p): p is (typeof pages)[number] => !!p)
    .map((p) => ({ href: p.path, name: p.town.name, line: (p.entry.data as any).h1 as string, meta: `${Math.round(miles(town, p.town))} mi ${compass(town, p.town)}` }));
  const others = [
    { href: `/areas/${town.slug}/`, name: `Artificial turf in ${name}`, line: townData.h1 as string, meta: 'The town page' },
    ...pages.filter((p) => p.town.slug === town.slug && p.id !== id).map((p) => ({ href: p.path, name: p.service.name, line: (p.entry.data as any).h1 as string })),
  ];

  /* H1: the record's claim; display.paint, a phrase of it, gets the painted mark (check-content holds it to the H1). */
  const h1: string = d.h1;
  const paint: string | undefined = d.display?.paint;
  const at = paint ? h1.indexOf(paint) : -1;
  const crumbs = [{ name: 'Areas', path: '/areas/' }, { name, path: `/areas/${town.slug}/` }, { name: meta.crumb, path }];
  const graph = [...townServiceGraph(`${service.name} in ${name}, CO`, service.name, path, d.description, name), ...faqGraph(d.faq)];
  const band = meta.band;
  /* A putting-green page links the golf communities in its town that have their own pages. */
  const golfHere = service.slug === 'putting-greens' ? communities.filter((c) => c.town.slug === town.slug && c.kind === 'golf') : [];
  return { page, town, service, meta, d, name, asOf, hoaAt, extra, codeRecs, lawRecs, photo, og, numbered, rows, nearby, others, h1, paint, at, crumbs, graph, band, golfHere };
}

/* ───────────── A community page ───────────── */
async function communityPage() {
  const c = communities.find((x) => x.id === id)!;
  const d = c.entry.data as any;
  const town = c.town;
  const townData = town.entry.data as any;
  const name: string = d.name;
  const townName: string = town.name;
  const asOf: string = d.checked;
  const path = c.path;
  const blocks = d.blocks as Block[];
  const numbered = blocks.map((b, i) => ({ b, no: i + 1, id: `${b.kind}-${i + 1}` }));
  /* The first block whose evidence panel shows each record: the review path points up to it instead of quoting twice. */
  const shownIn = new Map<string, { no: number; id: string }>();
  for (const { b, no, id: bid } of numbered) for (const r of b.layerRefs) if (!shownIn.has(r)) shownIn.set(r, { no, id: bid });

  /* Who reviews a yard here, and what its guidelines say, quoted from the records the record names. */
  const governing = d.governing ?? null;
  const rules = governing ? recs(governing.layerRefs).filter((r) => !HOA_FAMILY.has(r.id)).map((r) => ({ r, at: shownIn.get(r.id) ?? null })) : [];

  /* The Colorado backyard-HOA rule, once: after the first block that leans on it, else after the design review
     when a body reviews yards here. */
  const hoaAt = blocks.findIndex(leansOnHoa);
  const stateAfterReview = hoaAt < 0 && !!governing && governing.type !== 'none-found';
  const extra = HOA_EXTRA.filter((r) => blocks.some((b) => b.layerRefs.includes(r)) || governing?.layerRefs.includes(r));

  /* The course, only while its cited record renders (check-content holds the name to that record). */
  const golfRec = d.golf ? rec(d.golf.layerRef) : null;
  const golf = d.golf && golfRec ? { name: d.golf.name as string, record: golfRec } : null;

  const photo = d.photo ? photoById(d.photo) : null;
  const og = photo ? (await getImage({ src: photo.src, width: 1200, format: 'jpg', quality: 72 })).src : undefined;

  /* The job sheet: each block by its kind and kicker, then the design review and the photo when they're drawn. */
  const rows = [
    ...numbered.map(({ b, id: bid }) => ({ label: KIND_LABEL[b.kind] ?? b.kind, value: b.kicker, href: `#${bid}`, own: b.own })),
    ...(governing ? [{ label: 'Design review', value: governing.type === 'none-found' ? 'No guidelines found' : governing.name, href: '#review', own: false }] : []),
    ...(photo ? [{ label: 'Photo', value: photo.caption, href: '#photo', own: false }] : []),
  ];

  /* Around: the town's pages first (the town page, then its putting-green and pet-turf pages), then the other
     communities in the town. */
  const townLinks = [
    { href: `/areas/${town.slug}/`, name: `Artificial turf in ${townName}`, line: townData.h1 as string, meta: 'The town page' },
    ...COMMUNITY_SERVICES
      .map((s) => pages.find((p) => p.town.slug === town.slug && p.service.slug === s))
      .filter((p): p is (typeof pages)[number] => !!p)
      .map((p) => ({ href: p.path, name: p.service.name, line: (p.entry.data as any).h1 as string })),
  ];
  const neighbors = communities.filter((x) => x.town.slug === town.slug && x.id !== id)
    .map((x) => ({ href: x.path, name: x.name, line: COMMUNITY_SELL[x.id]?.line ?? (x.entry.data as any).h1 as string, meta: (KIND_NAMES as Record<string, string>)[x.kind] }));

  /* H1: the record's claim; display.paint, a phrase of it, gets the painted mark (check-content holds it to the H1). */
  const h1: string = d.h1;
  const paint: string | undefined = d.display?.paint;
  const at = paint ? h1.indexOf(paint) : -1;
  const crumbs = [{ name: 'Areas', path: '/areas/' }, { name: townName, path: `/areas/${town.slug}/` }, { name, path }];
  const { placeRef, nodes } = communityGraph({ name, town: townName, path, serviceName: `Artificial turf in ${name}, ${townName}, CO`, description: d.description });
  const graph = [...nodes, ...faqGraph(d.faq)];
  return {
    c, d, town, name, townName, asOf, numbered, governing, rules, hoaAt, stateAfterReview, extra, golf, photo, og, rows,
    townLinks, neighbors, h1, paint, at, crumbs, graph, placeRef, county: countyLine(town.county),
  };
}

const ts = kind === 'service' ? await townServicePage() : null;
/* On a community page these stay undefined, and the town × service template below is not drawn. */
const { page, town, service, meta, d, name, asOf, hoaAt, extra, codeRecs, lawRecs, photo, og, numbered, rows, nearby, others, h1, paint, at, crumbs, graph, band, golfHere } = ts ?? ({} as NonNullable<typeof ts>);
const cm = kind === 'community' ? await communityPage() : null;

/* The sales layer: the H1 names the job and the town; the hook sells it. The record's own claims live in the
   Good-to-know lines and the rules drawer. A page without its own job photo shows Brian's closest honest one,
   captioned with where it really is. */
const SERVICE_H1: Record<string, string> = { 'putting-greens': 'Backyard putting greens', 'pet-turf': 'Pet turf and dog runs', 'playground-turf': 'Playground turf', 'commercial-turf': 'Commercial and HOA turf' };
const SERVICE_HOOK: Record<string, (t: string) => string> = {
  'putting-greens': (t) => `We build backyard putting greens with the cups and the break where you want them, on a base that holds up to our freeze and thaw.`,
  'pet-turf': (t) => `We build dog runs that drain fast and rinse clean. No more mud or dead spots.`,
  'playground-turf': (t) => `We put soft, clean turf under swing sets and play sets, with padding matched to how high the kids climb.`,
  'commercial-turf': (t) => `We build turf for HOA common areas, parks, schools and fields, within Colorado’s rules for new landscapes.`,
};
const SERVICE_FALLBACK: Record<string, string> = { 'putting-greens': 'fire-pit', 'playground-turf': 'playset', 'pet-turf': 'gbp-dog-yard' };
/* No job photo of this kind yet: a scene of the kind of yard (scenes.ts), uncaptioned; commercial pages rotate three. */
const COMMERCIAL_SCENES = ['park-field', 'dog-park', 'hoa-common'];
const tsHero = ts
  ? (ts.photo
    ?? (SERVICE_FALLBACK[ts.service.slug] ? photoById(SERVICE_FALLBACK[ts.service.slug])
      : ts.service.slug === 'commercial-turf' ? scene(COMMERCIAL_SCENES[ts.town.slug.length % 3])
      : photoById('fire-pit')))
  : null;
const tsCaption = Boolean(ts?.photo);
const heroOg = tsHero ? (await getImage({ src: tsHero.src, width: 1200, format: 'jpg', quality: 72 })).src : undefined;
const cmHero = cm ? (cm.photo ?? photoById(cm.d.kind === 'golf' ? 'dusk' : 'fire-pit')) : null;
const cmOg = cmHero ? (await getImage({ src: cmHero.src, width: 1200, format: 'jpg', quality: 72 })).src : undefined;
/* Good-to-know lines: the blocks a buyer acts on first (rules, review, the course), trivia last. */
const PRIORITY = ['ordinance', 'hoa', 'design', 'place', 'golf', 'drought', 'rebate', 'access', 'utility', 'housing', 'soil', 'climate'];
const goodFrom = (numbered: { b: { kind: string; own: boolean; h2: string } }[]) => [...numbered]
  .sort((x, y) => (PRIORITY.indexOf(x.b.kind) + 99 * +(PRIORITY.indexOf(x.b.kind) < 0)) - (PRIORITY.indexOf(y.b.kind) + 99 * +(PRIORITY.indexOf(y.b.kind) < 0)) || +y.b.own - +x.b.own)
  .slice(0, 3).map(({ b }) => b.h2);
const cmTownPages = cm ? pages.filter((p) => p.town.slug === cm.town.slug) : [];
/* Town × service good-to-know: the town's own rule, one plain line about the job, then the HOA line (or, for
   commercial work, the town's second line). */
const SERVICE_GOOD: Record<string, string> = {
  'putting-greens': 'A green rolls only as true as the base under it, so the break is shaped and compacted before the turf goes down.',
  'pet-turf': 'Drainage and infill decide whether a dog yard smells, so both are planned around your dogs.',
  'playground-turf': 'The pad under the turf is matched to the height of your play set.',
  'commercial-turf': 'Since 2026, Colorado allows only functional turf, like play areas, fields and dog parks, in new commercial and common-area landscaping.',
};
const townGood = ts ? TOWN_SELL[town.slug]?.good : undefined;
const tsGood = ts && townGood
  ? [townGood[0], SERVICE_GOOD[service.slug], service.slug === 'commercial-turf' ? townGood.find((g, i) => i > 0 && g !== HOA_LINE) ?? townGood[1] : HOA_LINE].filter(Boolean) as string[]
  : ts ? goodFrom(numbered) : [];
---
{ts && (
<Base title={d.title} description={d.description} crumbs={crumbs} graph={graph} draft={page.draft} ogImage={og ?? heroOg}>
  <PageHero label={`${service.name} · ${name}, CO`} crumbs={crumbs} photo={tsHero} caption={tsCaption} lede={SERVICE_HOOK[service.slug]?.(name) ?? d.lede}>
    {SERVICE_H1[service.slug] ?? service.name} in <PaintWord now>{name}.</PaintWord>
    <div slot="after" class="tsvtop__acts">
      <a class="btn btn--paint" href="#estimate" data-cta="town-service-hero-quote">Book a yard walk <Icon name="arrow" /></a>
      {phoneHref && <a class="btn btn--line" href={phoneHref} data-cta="town-service-hero-call"><Icon name="phone" />Call <span class="btn__num">{phoneDisplay}</span></a>}
    </div>
  </PageHero>

  <SellTrust town={name} />

  {photo && <TownServicePhoto photo={photo} />}

  <SellGood place={name} answer={d.answer} good={tsGood} />
  {golfHere.length > 0 && (
    <section class="golfline"><div class="wrap"><p>Live in {golfHere.map((c, i) => <>{i > 0 && (i === golfHere.length - 1 ? ' or ' : ', ')}<a href={c.path}>{c.name}</a></>)}? See what your neighborhood allows for a backyard green.</p></div></section>
  )}

  <SellSteps town={name} />

  <TownServiceAround service={meta.crumb} town={name} nearby={nearby.map((n) => ({ ...n, line: '' }))} others={others.map((o, i) => ({ ...o, line: i === 0 ? (TOWN_SELL[town.slug]?.hook ?? '') : '' }))} />

  <TownServiceGuides topic={meta.topic} />

  {d.faq?.length > 0 && (
    <section class="section ground-2" id="faq" aria-labelledby="faq-h">
      <div class="wrap tsvfaq">
        <header class="tsvfaq__head">
          <h2 id="faq-h" class="tsvfaq__h">Questions about {meta.crumb.toLowerCase()}.</h2>
        </header>
        <Faq items={d.faq} name={`faq-${id}`} />
      </div>
    </section>
  )}

  <RulesDrawer title={`${name}’s rules for ${meta.crumb.toLowerCase()}, in full`}>
    <div class="wrap drawer__card">
      <TownServiceCard service={{ name: service.name, href: `/services/${service.slug}/` }}
        town={{ name, href: `/areas/${town.slug}/`, county: countyLine(town.county) }}
        rows={rows} checked={fmtDate(asOf)} sources={d.sources.length} />
    </div>
    {numbered.map(({ b, no, id: bid }, i) => (
      <>
        <TownBlock block={b} no={no} id={bid} town={name} sources={d.sources} asOf={asOf} />
        {i === hoaAt && <TownStateRule extra={extra} />}
      </>
    ))}
    <TownServiceCode town={name} code={codeRecs} law={lawRecs} lawLine={meta.lawLine} asOf={asOf} />
    <div class="wrap tsvsrc" id="sources"><Sources sources={d.sources} title={`Sources for ${meta.crumb.toLowerCase()} in ${name}, each with the date it was read`} /></div>
  </RulesDrawer>

  <CtaBand title={service.slug === 'commercial-turf' ? 'Let’s walk' : 'Let’s walk your'} payoff={service.slug === 'commercial-turf' ? 'the site.' : 'yard.'} lede={band.lede} town={name} use={service.formUse} />
</Base>
)}
{cm && (
<Base title={cm.d.title} description={cm.d.description} crumbs={cm.crumbs} graph={cm.graph} draft={cm.c.draft} ogImage={cm.og ?? cmOg} about={cm.placeRef} styles={[communityCss]}>
  <PageHero label={`${cm.name} · ${cm.townName}, CO`} crumbs={cm.crumbs} photo={cmHero} caption={Boolean(cm.photo)}
    lede={`We’ll design your turf or putting green around ${({ hoa: 'your HOA’s rules', 'metro-district': 'your metro district’s rules', both: 'your HOA’s and metro district’s rules' } as Record<string, string>)[cm.governing?.type ?? ''] ?? 'the rules that apply here'}, so you know what’s allowed before you start.`}>
    Turf and putting greens in <PaintWord now>{cm.name}.</PaintWord>
    <div slot="after" class="tsvtop__acts">
      <a class="btn btn--paint" href="#estimate" data-cta="community-hero-quote">Book a yard walk <Icon name="arrow" /></a>
      {phoneHref && <a class="btn btn--line" href={phoneHref} data-cta="community-hero-call"><Icon name="phone" />Call <span class="btn__num">{phoneDisplay}</span></a>}
    </div>
  </PageHero>

  <SellTrust town={cm.townName} />

  <SellGood place={cm.name} answer={cm.d.answer} good={COMMUNITY_SELL[`${cm.town.slug}--${cm.d.slug}`]?.good ?? goodFrom(cm.numbered)} />

  <SellServices town={cm.name} townPages={cmTownPages} heading="What we build." />

  {cm.photo && <TownServicePhoto photo={cm.photo} />}

  <SellSteps place={cm.name} />

  <TownServiceAround service={cm.name} town={cm.townName} nearby={cm.townLinks.map((n, i) => ({ ...n, line: i === 0 ? (TOWN_SELL[cm.town.slug]?.hook ?? '') : '' }))} others={cm.neighbors}
    heads={{ nearby: { label: `Around ${cm.name}`, title: `More in ${cm.townName}.` }, others: { label: `More in ${cm.townName}`, title: `Other ${cm.townName} neighborhoods.` } }} />

  <TownServiceGuides topic={COMMUNITY_TOPIC} picks={COMMUNITY_GUIDES} />

  {cm.d.faq?.length > 0 && (
    <section class="section ground-2" id="faq" aria-labelledby="faq-h">
      <div class="wrap tsvfaq">
        <header class="tsvfaq__head">
          <h2 id="faq-h" class="tsvfaq__h">Common questions.</h2>
        </header>
        <Faq items={cm.d.faq} name={`faq-${id}`} />
      </div>
    </section>
  )}

  <RulesDrawer title={`${cm.name}’s design rules, in full`}>
    <div class="wrap drawer__card">
      <TownServiceCard axis="Community" ownIn={cm.name} service={{ name: cm.name, href: '#facts' }}
        town={{ name: cm.townName, href: `/areas/${cm.town.slug}/`, county: cm.county }}
        rows={cm.rows} checked={fmtDate(cm.asOf)} sources={cm.d.sources.length} />
    </div>
    <CommunityFacts name={cm.name} kind={cm.d.kind} governing={cm.governing} golf={cm.golf}
      town={{ name: cm.townName, href: `/areas/${cm.town.slug}/`, county: cm.county }} checked={cm.asOf} />
    {cm.numbered.map(({ b, no, id: bid }, i) => (
      <>
        <TownBlock block={b} no={no} id={bid} town={cm.townName} ownIn={cm.name} sources={cm.d.sources} asOf={cm.asOf} />
        {i === cm.hoaAt && <TownStateRule extra={cm.extra} />}
      </>
    ))}
    {cm.governing && <CommunityReview name={cm.name} governing={cm.governing} rules={cm.rules} state={cm.hoaAt >= 0 || cm.stateAfterReview} checked={cm.asOf} />}
    {cm.stateAfterReview && <TownStateRule extra={cm.extra} />}
    <div class="wrap tsvsrc" id="sources"><Sources sources={cm.d.sources} title={`Sources for ${cm.name}, ${cm.townName}, each with the date it was read`} /></div>
  </RulesDrawer>

  <CtaBand title="Let’s walk your" payoff="yard." town={cm.townName}
    lede={`Tell us what you want and how to reach you. We’ll set a time to see the yard.`} />
</Base>
)}

