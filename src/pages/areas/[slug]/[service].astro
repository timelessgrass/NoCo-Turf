  .tsvfaq { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 40px 80px; align-items: start; }
  .tsvfaq__head { display: grid; gap: 16px; position: sticky; top: calc(var(--header-h) + 32px); }
  .tsvfaq__h { font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem); max-width: 14ch; }
